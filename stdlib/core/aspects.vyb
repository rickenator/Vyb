# core::aspects - Standard polymorphic contracts
#
# The six canonical core aspects define Vyb's standard behavior contracts:
# stringification (Display), debugging output (Debug), value cloning (Clone),
# and equality/comparison/hashing (Equatable / Comparable / Hashable). They are
# the aspect-side surface that collections (e.g. HashMap<K, V> with
# `Hashable + Equatable` bounds), the Iterator protocol, and generic algorithms
# constrain against. Comparable refines Equatable, so any type that binds
# Comparable must also bind Equatable.

share(all)
aspect Display {
    display(self)<String> -> { }
}

share(all)
aspect Debug {
    debug(self)<String> -> { }
}

share(all)
aspect Clone {
    clone(self)<Self> -> { }
}

share(all)
aspect Equatable {
    equals(self, other<Self>)<Bool> -> { }
}

share(all)
aspect Hashable {
    hash(self)<Int> -> { }
}

share(all)
aspect Comparable : Equatable {
    compare(self, other<Self>)<Int> -> { }
}

# ---------------------------------------------------------------------------
# Standard implementations for built-in scalar types.
#
# These pre-wired binds let the core contracts work out of the box for the
# common scalar types whenever this module (or the prelude) is imported, so
# e.g. `x.display()`, `a.equals(b)` and `a.compare(b)` resolve for Int/Float/
# Bool/String without authoring a bind. Bound (target, aspect) pairs are carried
# across module imports like any shared declaration.
# ---------------------------------------------------------------------------

share(all)
bind Display -> Int {
    display(self<Int>)<String> -> { return self.to_string() }
}

share(all)
bind Display -> Float {
    display(self<Float>)<String> -> { return self.to_string() }
}

share(all)
bind Display -> Bool {
    display(self<Bool>)<String> -> { return self.to_string() }
}

share(all)
bind Display -> String {
    display(self<String>)<String> -> { return self }
}

share(all)
bind Clone -> Int {
    clone(self<Int>)<Int> -> { return self }
}

share(all)
bind Clone -> String {
    clone(self<String>)<String> -> { return self }
}

share(all)
bind Equatable -> Int {
    equals(self<Int>, other<Int>)<Bool> -> { return self == other }
}

share(all)
bind Equatable -> Float {
    equals(self<Float>, other<Float>)<Bool> -> { return self == other }
}

share(all)
bind Equatable -> Bool {
    equals(self<Bool>, other<Bool>)<Bool> -> { return self == other }
}

share(all)
bind Equatable -> String {
    equals(self<String>, other<String>)<Bool> -> { return self == other }
}

share(all)
bind Comparable -> Int {
    compare(self<Int>, other<Int>)<Int> -> { return self - other }
}

share(all)
bind Comparable -> Float {
    compare(self<Float>, other<Float>)<Int> -> {
        if (self < other) { return -1 }
        if (self > other) { return 1 }
        return 0
    }
}

share(all)
bind Comparable -> Bool {
    compare(self<Bool>, other<Bool>)<Int> -> {
        if (self == other) { return 0 }
        if (self) { return 1 }
        return -1
    }
}

share(all)
bind Comparable -> String {
    compare(self<String>, other<String>)<Int> -> {
        # Byte-wise lexicographic string comparison, inlined in the bind body
        # (a module-local helper would not be visible when the bind is
        # activated cross-module, e.g. on `import prelude`).
        i<Int> = 0
        na<Int> = self.len()
        nb<Int> = other.len()
        while (i < na && i < nb) {
            ca<Int> = self.char_at(i)
            cb<Int> = other.char_at(i)
            if (ca < cb) { return -1 }
            if (ca > cb) { return 1 }
            i = i + 1
        }
        if (na < nb) { return -1 }
        if (na > nb) { return 1 }
        return 0
    }
}

share(all)
bind Hashable -> Int {
    hash(self<Int>)<Int> -> { return self }
}

share(all)
bind Hashable -> Bool {
    hash(self<Bool>)<Int> -> { if (self) { return 1 } return 0 }
}

# Shared DJB2-style hash over a string's character codes. Used by the String and
# Float Hashable binds (called as a plain function so it resolves inside the module).
share(all)
hash_chars(s<String>)<Int> -> {
    h<Int> = 0
    i<Int> = 0
    n<Int> = s.len()
    while (i < n) {
        c<Int> = s.char_at(i)
        h = h * 31 + c
        i = i + 1
    }
    return h
}

share(all)
bind Hashable -> String {
    hash(self<String>)<Int> -> {
        h<Int> = 0
        i<Int> = 0
        n<Int> = self.len()
        while (i < n) {
            c<Int> = self.char_at(i)
            h = h * 31 + c
            i = i + 1
        }
        return h
    }
}

share(all)
bind Hashable -> Float {
    hash(self<Float>)<Int> -> {
        s<String> = self.to_string()
        return hash_chars(s)
    }
}

# StringOps - String manipulation helpers layered on the built-in String methods.
# `.split(sep)` returns a `Vec<String>` of the parts between each occurrence of
# `sep` in `self` (an empty `sep` yields a single-element Vec holding the whole
# string; leading/trailing/consecutive separators produce empty parts, matching
# the common split semantics). Bound to String and always available, since this
# module is auto-imported into user programs.
share(all)
aspect StringOps {
    split(self<String>, sep<String>)<Vec<String>> -> { }
    # Index of the first occurrence of `needle`, or -1 when absent.
    index_of(self<String>, needle<String>)<Int> -> { }
    # Index of the first occurrence of `needle` at or after `start`, or -1 when
    # absent. No substring is allocated, so scanning a line for several keys stays
    # linear instead of the copy-and-rescan suffix workaround. `start` is clamped
    # to 0 from below, and `index_of_from(needle, 0)` matches `index_of(needle)`.
    index_of_from(self<String>, needle<String>, start<Int>)<Int> -> { }

    # #287: documented in the reference manual (language.md `to_int`/`to_float`,
    # PROGRAMMERS_GUIDE `s.to_int()`/`s.to_float()`). Parse a leading decimal
    # number: an optional sign, then digits; `to_float` also accepts a fraction
    # and an `e`/`E` exponent. A string with no digits yields 0 / 0.0.
    to_int(self<String>)<Int> -> { }
    to_float(self<String>)<Float> -> { }
}

share(all)
bind StringOps -> String {
    split(self<String>, sep<String>)<Vec<String>> -> {
        out<Vec<String>> = Vec<String>()
        n<Int> = self.len()
        sl<Int> = sep.len()
        if (sl == 0) {
            out.push(self)
            return out
        }
        start<Int> = 0
        i<Int> = 0
        while (i <= n - sl) {
            j<Int> = 0
            ok<Bool> = true
            while (ok && j < sl) {
                if (self.char_at(i + j) != sep.char_at(j)) {
                    ok = false
                }
                j = j + 1
            }
            if (ok) {
                out.push(self.substring(start, i))
                i = i + sl
                start = i
            } else {
                i = i + 1
            }
        }
        out.push(self.substring(start, n))
        return out
    }
    index_of(self<String>, needle<String>)<Int> -> {
        n<Int> = self.len()
        sn<Int> = needle.len()
        if (sn == 0) { return 0 }
        if (sn > n) { return -1 }
        i<Int> = 0
        while (i <= n - sn) {
            j<Int> = 0
            ok<Bool> = true
            while (ok && j < sn) {
                if (self.char_at(i + j) != needle.char_at(j)) {
                    ok = false
                }
                j = j + 1
            }
            if (ok) { return i }
            i = i + 1
        }
        return -1
    }
    index_of_from(self<String>, needle<String>, start<Int>)<Int> -> {
        n<Int> = self.len()
        sn<Int> = needle.len()
        off<Int> = start
        if (off < 0) { off = 0 }
        if (sn == 0) {
            if (off > n) { return -1 }
            return off
        }
        if (sn > n || off > n - sn) { return -1 }
        i<Int> = off
        while (i <= n - sn) {
            j<Int> = 0
            ok<Bool> = true
            while (ok && j < sn) {
                if (self.char_at(i + j) != needle.char_at(j)) {
                    ok = false
                }
                j = j + 1
            }
            if (ok) { return i }
            i = i + 1
        }
        return -1
    }

    # #287: leading decimal integer; a sign is honoured, scanning stops at the
    # first non-digit, and a string with no digits yields 0.
    to_int(self<String>)<Int> -> {
        n<Int> = self.len()
        i<Int> = 0
        neg<Bool> = false
        while (i < n && self.char_at(i) == 32) { i = i + 1 }
        if (i < n && (self.char_at(i) == 45 || self.char_at(i) == 43)) {
            if (self.char_at(i) == 45) { neg = true }
            i = i + 1
        }
        v<Int> = 0
        ok<Bool> = true
        while (ok && i < n) {
            c<Int> = self.char_at(i)
            if (c >= 48 && c <= 57) {
                v = v * 10 + (c - 48)
                i = i + 1
            } else {
                ok = false
            }
        }
        if (neg) { return 0 - v }
        return v
    }

    # #287: `[+-]d[.d][eE[+-]d]`; the same scanning rule as `to_int`.
    to_float(self<String>)<Float> -> {
        n<Int> = self.len()
        i<Int> = 0
        neg<Bool> = false
        while (i < n && self.char_at(i) == 32) { i = i + 1 }
        if (i < n && (self.char_at(i) == 45 || self.char_at(i) == 43)) {
            if (self.char_at(i) == 45) { neg = true }
            i = i + 1
        }
        whole<Float> = 0.0
        ok<Bool> = true
        while (ok && i < n) {
            c<Int> = self.char_at(i)
            if (c >= 48 && c <= 57) {
                whole = whole * 10.0 + (c - 48)
                i = i + 1
            } else {
                ok = false
            }
        }
        frac<Float> = 0.0
        scale<Float> = 1.0
        if (i < n && self.char_at(i) == 46) {
            i = i + 1
            ok = true
            while (ok && i < n) {
                c<Int> = self.char_at(i)
                if (c >= 48 && c <= 57) {
                    frac = frac * 10.0 + (c - 48)
                    scale = scale * 10.0
                    i = i + 1
                } else {
                    ok = false
                }
            }
        }
        val<Float> = whole + frac / scale
        if (i < n && (self.char_at(i) == 101 || self.char_at(i) == 69)) {
            i = i + 1
            eneg<Bool> = false
            if (i < n && (self.char_at(i) == 45 || self.char_at(i) == 43)) {
                if (self.char_at(i) == 45) { eneg = true }
                i = i + 1
            }
            e<Int> = 0
            ok = true
            while (ok && i < n) {
                c<Int> = self.char_at(i)
                if (c >= 48 && c <= 57) {
                    e = e * 10 + (c - 48)
                    i = i + 1
                } else {
                    ok = false
                }
            }
            k<Int> = 0
            while (k < e) {
                if (eneg) { val = val / 10.0 } else { val = val * 10.0 }
                k = k + 1
            }
        }
        if (neg) { return 0.0 - val }
        return val
    }
}
