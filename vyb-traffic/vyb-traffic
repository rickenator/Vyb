#!/usr/bin/env sh
# vyb-traffic launcher: run the Vyb implementation from a source checkout.
# Resolves symlinks, locates the repository build, sets VYB_STDLIB, and passes
# the FFI binding module path. Override the compiler with VYB=/path/to/vyb.
set -eu
SELF=$(readlink -f "$0")
DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
REPO=$(CDPATH= cd -- "$DIR/.." && pwd)
VYB=${VYB:-"$REPO/build/vyb"}
VYB_STDLIB=${VYB_STDLIB:-"$REPO/stdlib"}
export VYB_STDLIB
if [ ! -x "$VYB" ]; then
    echo "vyb-traffic: $VYB is not executable - build Vyb first (cmake --build build)" >&2
    exit 1
fi
exec "$VYB" "$DIR/vyb-traffic.vyb" --module-path "$REPO/bindings" "$@"
