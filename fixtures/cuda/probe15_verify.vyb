# Host runner for #301: loads probe15.ptx, launches all five probe kernels and
# reads every written slot back. A store/atomic must touch only its own element:
# 4-byte slots hold their own value (no 8-byte widening, no neighbour clobber),
# and the f64 controls stay 8 bytes. The word after each array is pre-filled with
# the guard pattern `fill` precisely so an over-wide access shows up as a changed
# guard word.
# Run: build/vyb --module-path bindings --module-path bindings/cuda fixtures/cuda/probe15_verify.vyb
import io::{open_read, read_all}
import cuda::{cuda_init, cuda_device_count, cuda_device, cuda_ctx_retain,
              cuda_module_load, cuda_module_func, cuda_mem_alloc, cuda_mem_free,
              cuda_launch, cuda_sync}
import cuda_binding::{cuMemcpyHtoD_v2, cuMemcpyDtoH_v2}

# Write the two-word descriptor [a, b] into ds, then launch `hf` as ONE block of
# `lanes` lanes (the kernels take the descriptor pointer as their only argument).
dlaunch2(hf<Int>, ds<Int>, a<Int>, b<Int>)<Int> -> {
    freedom {
        av<Int> = a; bv<Int> = b
        if (cuMemcpyHtoD_v2(ds + 0, loc(av), 8) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(ds + 8, loc(bv), 8) != 0) { return 15 }
    }
    if (cuda_launch(hf, 1 as CInt, 1 as CInt, 1 as CInt, 8 as CInt, 1 as CInt, 1 as CInt, ds) != 0) { return 12 }
    if (cuda_sync() != 0) { return 17 }
    return 0
}

# Same, for the three-word descriptor [a, b, c] of the array-atomic probe.
dlaunch3(hf<Int>, ds<Int>, a<Int>, b<Int>, c<Int>)<Int> -> {
    freedom {
        av<Int> = a; bv<Int> = b; cv<Int> = c
        if (cuMemcpyHtoD_v2(ds + 0, loc(av), 8) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(ds + 8, loc(bv), 8) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(ds + 16, loc(cv), 8) != 0) { return 15 }
    }
    if (cuda_launch(hf, 1 as CInt, 1 as CInt, 1 as CInt, 8 as CInt, 1 as CInt, 1 as CInt, ds) != 0) { return 12 }
    if (cuda_sync() != 0) { return 17 }
    return 0
}

# Same, for the four-word descriptor [a, b, c, d] of the f32 probe (two arrays).
dlaunch4(hf<Int>, ds<Int>, a<Int>, b<Int>, c<Int>, d<Int>)<Int> -> {
    freedom {
        av<Int> = a; bv<Int> = b; cv<Int> = c; dv<Int> = d
        if (cuMemcpyHtoD_v2(ds + 0, loc(av), 8) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(ds + 8, loc(bv), 8) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(ds + 16, loc(cv), 8) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(ds + 24, loc(dv), 8) != 0) { return 15 }
    }
    if (cuda_launch(hf, 1 as CInt, 1 as CInt, 1 as CInt, 8 as CInt, 1 as CInt, 1 as CInt, ds) != 0) { return 12 }
    if (cuda_sync() != 0) { return 17 }
    return 0
}

main()<Int> -> {
    lanes<Int> = 8
    fill<Int> = 286331153                      # 0x11111111 guard word
    d25<Int> = 4612811918334230528             # f64 2.5
    d15<Int> = 4609434218613702656             # f64 1.5 (st_f32 probe operand)
    d40<Int> = 4616189618054758400             # f64 4.0 == 8 lanes * 0.5
    f15<Int> = 1069547520                      # f32 1.5 == 0x3FC00000

    if (cuda_init() != 0) { return 7 }
    if (cuda_device_count() < 1) { return 8 }
    dev<CInt> = cuda_device(0)
    if (dev < 0) { return 14 }
    if (cuda_ctx_retain(dev) != 0) { return 14 }

    ptx<String> = ""
    match (open_read("fixtures/cuda/probe15.ptx")) {
        f -> {
            match (read_all(f)) {
                s -> { ptx = s }
                ? -> { return 13 }
            }
        }
        ? -> { return 13 }
    }
    hmod<Int> = cuda_module_load(ptx)
    if (hmod == 0) { return 9 }
    hf64<Int> = cuda_module_func(hmod, "st_f64_probe")
    hf64a<Int> = cuda_module_func(hmod, "atomic_f64_probe")
    hf32<Int> = cuda_module_func(hmod, "st_f32_probe")
    ha32<Int> = cuda_module_func(hmod, "atomic_i32_array_probe")
    hi32<Int> = cuda_module_func(hmod, "st_i32_probe")
    if (hf64 == 0 || hf64a == 0 || hf32 == 0 || ha32 == 0 || hi32 == 0) { return 10 }

    # da: st_f64 array (8x8 + guard word), db: atomic f64 accumulator,
    # dc: st_f32 array for the runtime Float operand (8x4 + guard), dcr: st_f32
    # array for the constant 1.5 operand, dd: atomic i32 array (8x4 + guard),
    # dcn: scalar i32 atomic cell (8 bytes -> two 4-byte words observed),
    # de: st_i32 array (8x4 + guard), ds: descriptor.
    da<Int> = cuda_mem_alloc(72)
    db<Int> = cuda_mem_alloc(8)
    dc<Int> = cuda_mem_alloc(40)
    dcr<Int> = cuda_mem_alloc(40)
    dd<Int> = cuda_mem_alloc(40)
    dcn<Int> = cuda_mem_alloc(8)
    de<Int> = cuda_mem_alloc(40)
    ds<Int> = cuda_mem_alloc(32)
    if (da == 0 || db == 0 || dc == 0 || dcr == 0 || dd == 0 || dcn == 0 || de == 0 || ds == 0) { return 11 }

    freedom {
        g<Int> = fill
        i<Int> = 0
        for (i in 0..8) { if (cuMemcpyHtoD_v2(da + i * 4, loc(g), 4) != 0) { return 16 } }
        for (i in 0..9) { if (cuMemcpyHtoD_v2(dc + i * 4, loc(g), 4) != 0) { return 16 } }
        for (i in 0..9) { if (cuMemcpyHtoD_v2(dcr + i * 4, loc(g), 4) != 0) { return 16 } }
        for (i in 0..9) { if (cuMemcpyHtoD_v2(dd + i * 4, loc(g), 4) != 0) { return 16 } }
        for (i in 0..1) { if (cuMemcpyHtoD_v2(dcn + i * 4, loc(g), 4) != 0) { return 16 } }
        for (i in 0..9) { if (cuMemcpyHtoD_v2(de + i * 4, loc(g), 4) != 0) { return 16 } }
        zero<Float> = 0.0
        if (cuMemcpyHtoD_v2(db, loc(zero), 8) != 0) { return 16 }
    }

    rc<Int> = dlaunch2(hf64, ds, da, lanes)
    if (rc != 0) { return rc }
    rc = dlaunch2(hf64a, ds, db, lanes)
    if (rc != 0) { return rc }
    rc = dlaunch4(hf32, ds, dc, lanes, d15, dcr)
    if (rc != 0) { return rc }
    rc = dlaunch3(ha32, ds, dd, dcn, lanes)
    if (rc != 0) { return rc }
    rc = dlaunch2(hi32, ds, de, lanes)
    if (rc != 0) { return rc }

    bad<Int> = -1
    s64<Int> = 0
    s32<Int> = 0
    scnt<Int> = 0
    freedom {
        i<Int> = 0
        t<Int> = 0
        u<Int> = 0
        # control: st_f64 -> 8-byte 2.5 per lane; guard word (64) survives.
        for (i in 0..(lanes - 1)) {
            if (cuMemcpyDtoH_v2(loc(u), da + i * 8, 8) != 0) { return 18 }
            if (u != d25) { bad = i }
        }
        if (cuMemcpyDtoH_v2(loc(u), da, 8) != 0) { return 18 }
        s64 = u
        # 4-byte reads land in the LOW word of an Int zeroed just before the copy.
        t = 0
        if (cuMemcpyDtoH_v2(loc(t), da + 64, 4) != 0) { return 18 }
        if (t != fill) { bad = 100 }
        # control: atomic_add_f64 -> 4.0 after 8 lanes x 0.5.
        if (cuMemcpyDtoH_v2(loc(u), db, 8) != 0) { return 18 }
        if (u != d40) { bad = 101 }
        # defect: st_f32 -> f32 1.5 in EACH 4-byte slot; guard word (32) survives.
        for (i in 0..(lanes - 1)) {
            t = 0
            if (cuMemcpyDtoH_v2(loc(t), dc + i * 4, 4) != 0) { return 18 }
            if (t != f15) { bad = 200 + i }
        }
        t = 0
        if (cuMemcpyDtoH_v2(loc(t), dc, 4) != 0) { return 18 }
        s32 = t
        t = 0
        if (cuMemcpyDtoH_v2(loc(t), dc + 32, 4) != 0) { return 18 }
        if (t != fill) { bad = 300 }
        # defect: the constant-1.5 f32 store must also be FOUR bytes wide.
        for (i in 0..(lanes - 1)) {
            t = 0
            if (cuMemcpyDtoH_v2(loc(t), dcr + i * 4, 4) != 0) { return 18 }
            if (t != f15) { bad = 350 + i }
        }
        t = 0
        if (cuMemcpyDtoH_v2(loc(t), dcr + 32, 4) != 0) { return 18 }
        if (t != fill) { bad = 390 }
        # defect: atomic_add_i32 on array slots -> fill+1 each; guard word (32) survives.
        for (i in 0..(lanes - 1)) {
            t = 0
            if (cuMemcpyDtoH_v2(loc(t), dd + i * 4, 4) != 0) { return 18 }
            if (t != fill + 1) { bad = 400 + i }
        }
        t = 0
        if (cuMemcpyDtoH_v2(loc(t), dd + 32, 4) != 0) { return 18 }
        if (t != fill) { bad = 500 }
        # defect: the scalar atomic cell is ONE 4-byte Int32 word: low word gets
        # fill+8 (8 increments), the second word stays fill -- a .u64 atomic would
        # have moved both words.
        t = 0
        if (cuMemcpyDtoH_v2(loc(t), dcn, 4) != 0) { return 18 }
        if (t != fill + lanes) { bad = 501 }
        scnt = t
        t = 0
        if (cuMemcpyDtoH_v2(loc(t), dcn + 4, 4) != 0) { return 18 }
        if (t != fill) { bad = 502 }
        # defect: st_i32 -> 7 in EACH 4-byte slot; guard word (32) survives.
        for (i in 0..(lanes - 1)) {
            t = 0
            if (cuMemcpyDtoH_v2(loc(t), de + i * 4, 4) != 0) { return 18 }
            if (t != 7) { bad = 600 + i }
        }
        t = 0
        if (cuMemcpyDtoH_v2(loc(t), de + 32, 4) != 0) { return 18 }
        if (t != fill) { bad = 700 }
    }
    cuda_mem_free(da); cuda_mem_free(db); cuda_mem_free(dc); cuda_mem_free(dcr)
    cuda_mem_free(dd); cuda_mem_free(dcn); cuda_mem_free(de); cuda_mem_free(ds)

    if (bad >= 0) {
        println("PROBE15 FAIL at check ")
        println_int(bad)
        return 1
    }
    println("PROBE15 PASS")
    println("  st_f64 lane0 bits = ")
    println_int(s64)
    println(" (2.5)")
    println("  atomic_f64 = 4.0")
    println("  st_f32[0] bits = ")
    println_int(s32)
    println(" (0x3FC00000 = 1.5f)")
    println("  atomic_i32 array = fill+1 per slot; cnt = fill+8 = ")
    println_int(scnt)
    println("; st_i32 = 7 per slot; all guard words intact")
    return 0
}
