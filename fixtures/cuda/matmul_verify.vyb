# Vyb CUDA shared-memory tiled-matmul host runner (issue #198 P4 + module adoption).
# This runner ADOPTS the posted, SIGNED bindings/cuda module (issue #198 P3) instead
# of hand-rolling the CUDA driver API: init/ctx/device, module load, function lookup,
# alloc, single-arg launch, sync, and free all come from `import cuda::{...}`. The f64
# (Float) data transfers come from the SAME signed binding's raw externs via
# `import cuda_binding::{cuMemcpyHtoD_v2, cuMemcpyDtoH_v2}` — requiring the binding
# subdir on the module path (see below), since cuMemcpy is not re-exported from the
# `cuda` wrapper surface (which ships i32 read/write helpers only).
#
# Run (JIT, io-importing runner):
#     build/vyb --module-path bindings --module-path bindings/cuda \
#         fixtures/cuda/matmul_verify.vyb
# after emitting the kernel: build/vyb --kernel fixtures/kernel/matmul_smem.vyb
#   --ptx fixtures/cuda/matmul_smem.ptx
#
# NOTE: importing both `cuda` (dir bindings/cuda/mod.vyb) and `cuda_binding` requires
# BOTH --module-path bindings (for `cuda`) and --module-path bindings/cuda (for
# `cuda_binding.vyb`). Do NOT re-declare cuMemcpyHtoD_v2 locally — the `cuda` module
# already carries that symbol and a local extern becomes unresolved (name collision).
#
# Matrices: n=16; A[r][c]=r+1, B[r][c]=c+1  =>  C[r][c] = 16*(r+1)*(c+1).
import io::{open_read, read_all}
import cuda::{cuda_init, cuda_device_count, cuda_device, cuda_ctx_retain,
              cuda_module_load, cuda_module_func, cuda_mem_alloc, cuda_mem_free,
              cuda_launch, cuda_sync}
import cuda_binding::{cuMemcpyHtoD_v2, cuMemcpyDtoH_v2}

main()<Int> -> {
    n<Int> = 16
    nbytes<Int> = n * n * 8                       # 2048

    # --- context via the signed module ---
    if (cuda_init() != 0) { return 7 }
    if (cuda_device_count() < 1) { return 8 }
    dev<CInt> = cuda_device(0)
    if (dev < 0) { return 14 }
    if (cuda_ctx_retain(dev) != 0) { return 14 }

    ptx<String> = ""
    match (open_read("fixtures/cuda/matmul_smem.ptx")) {
        f -> {
            match (read_all(f)) {
                s -> { ptx = s }
                ? -> { return 13 }
            }
        }
        ? -> { return 13 }
    }

    # --- device resources via the module ---
    hmod<Int> = cuda_module_load(ptx)
    if (hmod == 0) { return 9 }
    hf<Int> = cuda_module_func(hmod, "matmul_smem")
    if (hf == 0) { return 10 }
    dA<Int> = cuda_mem_alloc(nbytes)
    dB<Int> = cuda_mem_alloc(nbytes)
    dC<Int> = cuda_mem_alloc(nbytes)
    dd<Int> = cuda_mem_alloc(32)
    if (dA == 0 || dB == 0 || dC == 0 || dd == 0) { return 11 }

    # Upload A[r][c]=r+1 and B[r][c]=c+1 element-wise (raw f64 HtoD; module has i32 only).
    freedom {
        i<Int> = 0
        for (i in 0..(n * n - 1)) {
            r<Int> = i / n
            c<Int> = i % n
            av<Float> = 1.0 * (r + 1)
            bv<Float> = 1.0 * (c + 1)
            if (cuMemcpyHtoD_v2(dA + i * 8, loc(av), 8) != 0) { return 15 }
            if (cuMemcpyHtoD_v2(dB + i * 8, loc(bv), 8) != 0) { return 15 }
        }
    }
    # Write the descriptor dsc=[n, A, B, C] on device.
    freedom {
        nv<Int> = n; avp<Int> = dA; bvp<Int> = dB; cvp<Int> = dC
        if (cuMemcpyHtoD_v2(dd + 0, loc(nv), 8) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(dd + 8, loc(avp), 8) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(dd + 16, loc(bvp), 8) != 0) { return 15 }
        if (cuMemcpyHtoD_v2(dd + 24, loc(cvp), 8) != 0) { return 15 }
    }

    # Launch via the module's cuda_launch (single 8-byte arg = descriptor ptr).
    rc<CInt> = cuda_launch(hf, 1 as CInt, 1 as CInt, 1 as CInt, 16 as CInt, 16 as CInt, 1 as CInt, dd)
    if (rc != 0) { return 12 }
    cuda_sync()

    # Read back and verify against the reference 16*(r+1)*(c+1).
    bad<Int> = -1
    freedom {
        r2<Int> = 0
        for (r2 in 0..(n - 1)) {
            c2<Int> = 0
            for (c2 in 0..(n - 1)) {
                cv<Float> = 0.0
                if (cuMemcpyDtoH_v2(loc(cv), dC + (r2 * n + c2) * 8, 8) != 0) { return 16 }
                exp<Float> = 16.0 * (r2 + 1) * (c2 + 1)
                if (cv != exp) { bad = r2 * n + c2 }
            }
        }
    }
    cuda_mem_free(dA); cuda_mem_free(dB); cuda_mem_free(dC); cuda_mem_free(dd)

    if (bad < 0) {
        println("MATMUL PASS (via bindings/cuda module)")
        return 0
    }
    println("MATMUL FAIL at flat index ")
    println_int(bad)
    return 1
}
