// @test: Vec<UInt8>/Vec<UInt16> stride by their declared element type (#281)
// @description: push/set used the pushed value's i64 width as the element stride,
//   so narrow element Vecs stored elements 8 bytes apart while get read them 1-2
//   bytes apart: right length, garbage contents. Covers get/set and a narrow Vec
//   returned from a function.
// @category: collections, types
// @expect: pass
// @expect-output: b=3 65 66 67 u16=2 1000 2000 set=99 ret=2 66

import collections

fill()<Vec<UInt8>> -> {
    out<Vec<UInt8>> = Vec<UInt8>()
    out.push(65)
    out.push(66)
    return out
}

main()<Int> -> {
    b<Vec<UInt8>> = Vec<UInt8>()
    b.push(65)
    b.push(66)
    b.push(67)
    print("b=")
    print(b.len())
    print(" ")
    print(b.get(0))
    print(" ")
    print(b.get(1))
    print(" ")
    print(b.get(2))

    u<Vec<UInt16>> = Vec<UInt16>()
    u.push(1000)
    u.push(2000)
    print(" u16=")
    print(u.len())
    print(" ")
    print(u.get(0))
    print(" ")
    print(u.get(1))

    b.set(1, 99)
    print(" set=")
    print(b.get(1))

    r<Vec<UInt8>> = fill()
    print(" ret=")
    print(r.len())
    print(" ")
    print(r.get(1))
    return 0
}
