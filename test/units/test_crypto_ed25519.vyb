// @test: crypto::ed25519 keygen/sign/verify against RFC 8032 vectors + tamper rejection (#219)
// @description: Ed25519 signature primitives for the VybChain signature layer.
//   Validates deterministic public-key derivation and signatures against the
//   RFC 8032 TEST 1 (empty message) and TEST 2 (single 0x72 byte) vectors,
//   a self round-trip (sign -> verify), and rejects both a wrong message and a
//   single-hex-char-tampered signature. Backed by OpenSSL EVP_ED25519 in the
//   runtime (vyb_runtime.c __vyb_ed25519_*); on a no-OpenSSL build the module's
//   helpers fail cleanly and these checks return non-zero.
// @category: crypto, ed25519, signatures, stdlib
// @expect: pass
// @expect-return: 0

import crypto::{ed25519_publickey, ed25519_sign, ed25519_verify}

main()<Int> -> {
    # RFC 8032 TEST 1: seed, empty message
    seed1<String> = "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"
    expPub1<String> = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
    expSig1<String> = "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"

    pk1<String> = ed25519_publickey(seed1)
    if (pk1 != expPub1) { println("TEST1 BAD_PUB " + pk1); return 1 }
    sig1<String> = ed25519_sign(seed1, "")
    if (sig1 != expSig1) { println("TEST1 BAD_SIG"); return 2 }
    if (!ed25519_verify(pk1, "", sig1)) { println("TEST1 VERIFY_FAIL"); return 3 }

    # RFC 8032 TEST 2: seed, message = single byte 0x72 ('r')
    seed2<String> = "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"
    expPub2<String> = "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"
    expSig2<String> = "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"
    pk2<String> = ed25519_publickey(seed2)
    if (pk2 != expPub2) { println("TEST2 BAD_PUB"); return 4 }
    sig2<String> = ed25519_sign(seed2, "r")
    if (sig2 != expSig2) { println("TEST2 BAD_SIG"); return 5 }
    if (!ed25519_verify(pk2, "r", sig2)) { println("TEST2 VERIFY_FAIL"); return 6 }

    # self round-trip on a longer message + tamper rejection
    sigR<String> = ed25519_sign(seed1, "va10-boot-2026-09-11:release")
    if (!ed25519_verify(pk1, "va10-boot-2026-09-11:release", sigR)) { println("ROUNDTRIP FAIL"); return 7 }
    # wrong message must NOT verify
    if (ed25519_verify(pk1, "va10-boot-2026-09-11:releaseX", sigR)) { println("WRONG_MSG ACCEPTED"); return 8 }
    # tampered signature (leading 'e' flipped to 'f') must NOT verify
    tampered<String> = "f5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
    if (ed25519_verify(pk1, "", tampered)) { println("TAMPER ACCEPTED"); return 9 }

    println("ed25519-ok")
    return 0
}
