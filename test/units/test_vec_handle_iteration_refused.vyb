// @test: a module whose code generation reported an unresolved type is refused, not run (#427 defect 6)
// @description: iterating a `Vec` of ownership handles (`for (x in Vec<mild<A>>)`, with the iterator
//   module in scope) surfaces a codegen-only type error: the generic substitution produces a type
//   node whose name is the APPLIED string "mild<A>", which the ownership branch of codegenType
//   (`typeNameStr == "mild"`) does not match, so the user-type lookup fails and the type becomes
//   "unknown". The module still VERIFIED, so the program was JIT'd and RUN with the broken IR and
//   died at runtime (exit 139, faulting inside __vyb_int_to_string with a pointer argument) instead
//   of reporting. It is now a hard codegen error: the pipeline refuses to run the module.
// @category: ownership, diagnostics
// @expect: fail
// @expect-error: refusing to run a module whose code generation reported errors

import collections

share(all)
struct A { v<Int> }

main()<Int> -> {
    xs<Vec<mild<A>>> = Vec()
    o<our<A>> = our(A { v: 1 })
    xs.push(soft(o))
    n<Int> = 0
    for (x in xs) { if (!x.released()) { n = n + 1 } }
    println("live=" + n.to_string())
    return 0
}
