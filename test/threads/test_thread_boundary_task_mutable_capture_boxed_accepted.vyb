// @test: task_spawn accepts a boxed mutable capture
// @description: The task_spawn counterpart of the thread_spawn fixture. A task runs
//   its closure on a pthread, so the mutable capture used to be refused for holding
//   the defining frame's address; checkpoint (b)(1) boxes the capture instead, and
//   checkpoint (c) promotes the binding to ONE refcounted cell shared with the
//   spawning frame -- so the task's write is visible to the spawner after the await
//   (`spawner=42`), not just inside the closure.
// @category: threads, tasks, thread-boundary, ownership, lambda, closure, mutable
// @expect: pass
// @expect-output: task=42 spawner=42
// @expect-return: 0
// @env: VYB_STDLIB=stdlib

import tasks::{task_spawn, task_await, task_free}

main()<Int> -> {
    n<Int> = 41
    t<Int> = task_spawn(|| -> {
        n = n + 1
        return n
    }) else -1
    if (t < 0) { return 1 }

    got<Int> = task_await(t)
    if (got != 42) { return 2 }
    task_free(t)

    println("task=" + got.to_string() + " spawner=" + n.to_string())
    return 0
}
