# Agents - backpressure + bounded mailboxes (Stage 5).
#   - `agent_start(behavior, cap)` bounds the mailbox; a full bounded send
#     returns 0 immediately (non-blocking backpressure), mirroring channels.
#   - once the worker drains, sends are accepted again; nothing is lost.
#   - 0/omitted capacity stays unbounded (all sends accepted).
# Works for Int, Bool/Float (int-slot) and String (strchan) mailboxes.
// @test: Agents - bounded mailboxes and backpressure (Stage 5)
// @category: agents,concurrency,backpressure,stdlib
// @expect: pass
// @expect-return: 0

import agents
import channels

main()<Int> -> {
    # A bounded Int agent (cap 3). The behavior blocks on `gate` before handling
    # each message, so the worker holds one message and the mailbox buffers the
    # rest: total outstanding = 1 in-flight + 3 buffered = 4.
    gate<Int> = chan_new() else 0
    out<Int> = chan_new() else 0
    a<Int> = agent_start(|message<Int?>| -> {
        match (message) {
            v -> {
                chan_recv(gate)
                chan_send(out, v)
            }
            ? -> { }
        }
    }, 3) else 0
    if (a == 0) { return 1 }

    # Fill until the bounded mailbox rejects a send.
    sends<Int> = 0
    while (true) {
        r<Bool> = agent_send(a, sends + 1) else false
        if (!r) { break }
        sends = sends + 1
        if (sends > 100) { return 2 }
    }
    # The worker may have consumed one in-flight message or not by the time the
    # box fills, so `sends` is cap..cap+1; the box itself is always full (cap).
    if (sends < 3 || sends > 4) { return 3 }
    if (agent_len(a) != 3) { return 4 }   # box is full: 3 buffered
    if (agent_send(a, 500) else false) { return 5 }   # full -> absent

    # Drain with one gate token per outstanding message; replies are FIFO.
    i<Int> = 1
    while (i <= sends) {
        chan_send(gate, 1)
        rv<Int> = chan_recv(out) else -1
        if (rv != i) { return 6 }
        i = i + 1
    }
    if (agent_len(a) != 0) { return 7 }
    if (!(agent_send(a, 77) else false)) { return 8 }   # emptied -> accepts again

    chan_send(gate, 1)
    if ((chan_recv(out) else -1) != 77) { return 9 }
    agent_close(a)
    agent_free(a)

    # A bounded String agent exercises the strchan mailbox path. The mailbox
    # accepts at most `cap` messages AHEAD of the worker, and "ahead" counts the
    # message the worker is currently handling too, so how many sends succeed
    # before one is refused depends on how far the worker has progressed -- racy
    # by nature. What holds regardless of timing:
    #   (a) the mailbox never buffers more than cap;
    #   (b) once the worker drains, sends are accepted again -- nothing is lost.
    # This section used to assert "a retry right after the refusal must still
    # fail", which raced the worker's consume and flaked (~1 run in 6 returned
    # 13). It now asserts only timing-independent invariants and waits on the
    # worker's actual progress via blocking `chan_recv` (never a spin budget).
    sgate<Int> = chan_new() else 0
    sout<Int> = chan_new() else 0
    sa<Int> = agent_start_string(|message<String?>| -> {
        match (message) {
            sv -> { chan_recv(sgate); chan_send(sout, 1) }
            ? -> { }
        }
    }, 2) else 0
    if (!(agent_send_string(sa, "a") else false)) { return 10 }
    if (!(agent_send_string(sa, "b") else false)) { return 11 }
    # Fill until refused. `ssends` is cap plus whatever the worker had already
    # taken, so it is only lower-bounded by cap.
    ssends<Int> = 2
    while (true) {
        r<Bool> = agent_send_string(sa, "x") else false
        if (!r) { break }
        ssends = ssends + 1
        if (ssends > 100) { return 12 }
    }
    # (a) the mailbox never buffers more than its cap.
    if (ssends < 2) { return 12 }
    if (agent_len(sa) > 2) { return 13 }
    # (b) Release the worker one message at a time and confirm each slot frees.
    # `chan_recv` BLOCKS until the worker has handled the message, so this waits
    # for real progress instead of racing the worker's scheduler.
    chan_send(sgate, 1)
    if ((chan_recv(sout) else -1) != 1) { return 14 }   # worker handled one
    if (agent_len(sa) > 2) { return 14 }                # still never over cap
    # With a slot proven free, a send must now be accepted (positive direction).
    if (!(agent_send_string(sa, "c") else false)) { return 15 }
    # Drain the remainder: one token per outstanding message, each confirmed by a
    # blocking reply. Every message that was accepted must be handled exactly
    # once, so the total replies equal the number accepted (`ssends` plus "c").
    got<Int> = 1
    while (got < ssends + 1) {
        chan_send(sgate, 1)
        if ((chan_recv(sout) else -1) != 1) { return 16 }
        got = got + 1
    }
    if (agent_len(sa) != 0) { return 16 }
    agent_close(sa)
    agent_free(sa)
    chan_free(sgate)
    chan_free(sout)

    # Unbounded (0 / omitted): every send is accepted.
    u<Int> = agent_start(|v<Int?>| -> { }, 0) else 0
    c<Int> = 0
    while (c < 100) {
        if (!(agent_send(u, c) else false)) { return 15 }
        c = c + 1
    }
    agent_close(u)
    agent_free(u)

    chan_free(gate)
    chan_free(out)
    println("ok")
    return 0
}
