// @test: an integer literal assigned into a CInt slot is stored as 4 bytes
// @description: `c = -1` with c a CInt stored an i64 into the i32 slot (warning "Storing i64 into location of type i32"), writing 8 bytes into a 4-byte slot; the assignment now truncates the literal to the slot width
// @category: basic, cast
// @expect: pass
// @expect-output: -1 7 3
// @expect-return: 0

main()<Int> -> {
    var<CInt> a = 5
    var<CInt> b = 7
    var<CInt> c = 9
    a = -1
    c = 0
    c += 3
    println(a.to_string() + " " + b.to_string() + " " + c.to_string())
    if (a != -1) { return 1 }
    if (b != 7) { return 2 }
    if (c != 3) { return 3 }
    return 0
}
