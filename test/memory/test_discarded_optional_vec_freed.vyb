// @test: a discarded Vec<scalar>? call result is freed
// @description: A call returning a native `Vec<scalar>?` used as a bare statement
//   (`socket_recv_bytes_exact(fd, 8)` to drain a frame, a user function returning
//   `Vec<Int>?` called for its side effect) has no binding to free its payload on
//   scope exit, so the statement itself must release the present payload's data
//   buffer. Regression: the discarded optional was dropped without a free, leaking
//   the buffer once per evaluation (LeakSanitizer: __vyb_net_recv_bytes). The absent
//   optional and the bound / matched forms keep working.
// @category: memory, ownership, network, regression
// @expect: pass
// @expect-output: discarded-optvec-ok
// @expect-return: 0
// @env: VYB_STDLIB=stdlib

import network::{socket_open, socket_bind, socket_listen, socket_accept,
                 socket_connect, socket_local_port, socket_close,
                 socket_send_bytes, socket_recv_bytes_exact, Socket}

calls<Int> = 0

counted(n<Int>)<Vec<Int>?> -> {
    calls = calls + 1
    if (n < 0) { return nil }
    v<Vec<Int>> = Vec()
    i<Int> = 0
    while (i < n) { v.push(i) ; i = i + 1 }
    return v
}

main()<Int> -> {
    srv<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, 0) else -1
    if (srv < 0) { return 1 }
    if (!(socket_bind(srv, "127.0.0.1", 0) else false)) { return 2 }
    if (!(socket_listen(srv, 1) else false)) { return 3 }
    port<Int> = socket_local_port(srv) else -1
    cli<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, 0) else -1
    if (!(socket_connect(cli, "127.0.0.1", port) else false)) { return 4 }
    conn<Int> = socket_accept(srv) else -1
    if (conn < 0) { return 5 }

    frame<Vec<UInt8>> = Vec()
    k<Int> = 0
    while (k < 16) { frame.push((k + 1) as UInt8) ; k = k + 1 }

    # Drain 16-byte frames by discarding the exact read, many times over: each
    # discarded result owns a fresh 16-byte buffer.
    r<Int> = 0
    while (r < 64) {
        if ((socket_send_bytes(cli, view(frame)) else -1) != 16) { return 10 }
        socket_recv_bytes_exact(conn, 8)
        socket_recv_bytes_exact(conn, 8)
        r = r + 1
    }
    # The stream is still in step: the next frame reads back intact.
    if ((socket_send_bytes(cli, view(frame)) else -1) != 16) { return 11 }
    match (socket_recv_bytes_exact(conn, 16)) {
        got -> { if ((got.get(0) as Int) != 1 || (got.get(15) as Int) != 16) { return 12 } }
        ? -> { return 13 }
    }

    # A user function returning Vec<Int>?: present, empty and absent results discarded.
    j<Int> = 0
    while (j < 64) {
        counted(32)
        counted(0)
        counted(0 - 1)
        j = j + 1
    }
    if (calls != 192) { return 20 }
    # A bound result is still freed by its own scope and stays usable.
    kept<Vec<Int>?> = counted(5)
    match (kept) {
        v -> { if (v.len() != 5 || v.get(4) != 4) { return 21 } }
        ? -> { return 22 }
    }

    socket_close(cli)
    socket_close(conn)
    socket_close(srv)
    println("discarded-optvec-ok")
    return 0
}
