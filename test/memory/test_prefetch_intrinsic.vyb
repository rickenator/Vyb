// @test: prefetch intrinsic
// @description: prefetch(addr[, rw[, locality]]) lowers to llvm.prefetch; it is a pure cache hint with no effect on results (even for addresses that are not mapped)
// @category: memory, intrinsics, optimization
// @expect: pass
// @expect-return: 42

extern "C" {
    calloc(n<Int>, sz<Int>)<Int>
}

main()<Int> -> {
    var<Int> n = 4096
    var<Int> p = 0
    freedom { p = calloc(n, 8) }
    var<Int> i = 0
    var<Int> sum = 0
    while (i < n) {
        prefetch(p + (i + 64) * 8)
        prefetch(p + (i + 128) * 8, 0, 0)
        prefetch(p + i * 8, 1)
        prefetch(p + i * 8, 1, 3)
        freedom { at(from<loc<Int>>(p + i * 8)) = i }
        i = i + 1
    }
    i = 0
    while (i < n) {
        prefetch(p + (i + 16) * 8, 0, 1)
        freedom { sum = sum + at(from<loc<Int>>(p + i * 8)) }
        i = i + 1
    }
    // prefetching an unmapped address never faults
    prefetch(0)
    prefetch(8, 1, 2)
    if (sum != n * (n - 1) / 2) { return 1 }
    return 42
}
