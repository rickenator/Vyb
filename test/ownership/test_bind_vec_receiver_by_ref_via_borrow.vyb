// @test: By-ref their<Vec<T>> bind receiver through a borrowed param (#254)
// @description: The by-ref form (`self<their<Vec<T>>>`) must keep receiving the
//   Vec view pointer, not a by-value copy.
// @category: ownership, aspect, vec
// @expect: pass
// @expect-return: 2

import collections
aspect Bag { size(self)<Int> -> { } }
bind<T> Bag -> Vec<T> { size(self<their<Vec<T>>>)<Int> -> { return self.len() } }
count(v<their<Vec<Int>>>)<Int> -> { return v.size() }
main()<Int> -> {
    xs<Vec<Int>> = Vec()
    xs.push(7)
    xs.push(8)
    return count(borrow(xs))
}
