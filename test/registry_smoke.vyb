// @not-a-test: true
# registry_smoke.vyb -- end-to-end smoke test for the directory package registry
# and `version:` dependencies. Vyb port of test/registry_smoke.py; part of the
# #226 "no Python in the test path" work.
#
# Flow:
#   1. publish three versions of a package (1.0.0, 1.1.0, 2.0.0) through
#      `vyb mod publish` into a temp VYB_REGISTRY directory
#   2. a consumer declaring `{ version = "1" }` resolves the highest 1.x (1.1.0)
#      into .vybmod/, records source="version" in vyb.lock, builds and runs
#   3. a consumer declaring `{ version = "1.0.0" }` resolves exactly 1.0.0
#
# Exits non-zero on any failure so it can gate hosted CI.
#
# Usage: vyb test/registry_smoke.vyb [path-to-vyb]
#        (defaults to build/vyb, then build-ci/vyb)
import io::{close, File, open_read, open_write, read_all, write_str}
import process::{exec_output}

# ---------------------------------------------------------------- small helpers

# Index of the last '/' in `p`, or -1.
last_slash(p<String>)<Int> -> {
    i<Int> = p.len() - 1
    while (i >= 0) {
        if (((p.char_at(i) as Int) & 0xFF) == 47) { return i }
        i = i - 1
    }
    return -1
}

# Directory part of `p` ("" when there is no slash).
dirname_of(p<String>)<String> -> {
    i<Int> = last_slash(p)
    if (i < 0) { return "" }
    return p.substring(0, i)
}

# Strip leading/trailing whitespace (spaces, tabs, CR, LF) from `s`.
trim(s<String>)<String> -> {
    a<Int> = 0
    n<Int> = s.len()
    while (a < n) {
        c<Int> = (s.char_at(a) as Int) & 0xFF
        if (c == 32 || c == 9 || c == 13 || c == 10) { a = a + 1 } else { break }
    }
    b<Int> = n
    while (b > a) {
        c<Int> = (s.char_at(b - 1) as Int) & 0xFF
        if (c == 32 || c == 9 || c == 13 || c == 10) { b = b - 1 } else { break }
    }
    if (b <= a) { return "" }
    return s.substring(a, b)
}

# Decimal value of a digit string (stops at the first non-digit).
digits_to_int(s<String>)<Int> -> {
    t<String> = trim(s)
    n<Int> = 0
    i<Int> = 0
    while (i < t.len()) {
        c<Int> = (t.char_at(i) as Int) & 0xFF
        if (c < 48 || c > 57) { break }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    return n
}

# Run `cmd` through the shell and return its stdout ("" when it could not run).
run_sh(cmd<String>)<String> -> {
    out<String> = ""
    freedom {
        match (exec_output(cmd)) {
            s -> { out = s }
            ? -> { out = "" }
        }
    }
    return out
}

# Read a whole file as a String ("" when it cannot be read).
slurp(path<String>)<String> -> {
    text<String> = ""
    match (open_read(path)) {
        f -> {
            match (read_all(f)) { s -> { text = s } ? -> { } }
            close(f)
        }
        ? -> { }
    }
    return text
}

# Write `text` to `path`; true when the whole string was written.
spill(path<String>, text<String>)<Bool> -> {
    match (open_write(path)) {
        f -> {
            match (write_str(f, text)) { n -> { close(f); return (n == text.len()) } ? -> { close(f); return false } }
        }
        ? -> { return false }
    }
    return false
}

# True when `p` exists (file or directory).
exists(p<String>)<Bool> -> {
    return (trim(run_sh("test -e '" + p + "' && echo yes || echo no")) == "yes")
}

# Create `d` (and parents). `open_write` does not create directories, so every
# fixture directory goes through this first.
ensure_dir(d<String>)<Bool> -> {
    run_sh("mkdir -p '" + d + "'")
    return exists(d)
}

# Absolute form of `p`: relative paths resolve against `base`.
absolute(p<String>, base<String>)<String> -> {
    if (p.len() > 0 && (((p.char_at(0) as Int) & 0xFF) == 47)) { return p }
    return trim(run_sh("cd '" + base + "' && pwd")) + "/" + p
}

# ------------------------------------------------------- command line (/proc)

# The program's argv, parsed from `/proc/self/cmdline` (NUL separated).
argv_of()<Vec<String>> -> {
    raw<String> = slurp("/proc/self/cmdline")
    out<Vec<String>> = Vec<String>()
    cur<String> = ""
    i<Int> = 0
    while (i < raw.len()) {
        c<Int> = (raw.char_at(i) as Int) & 0xFF
        if (c == 0) {
            if (cur.len() > 0) { out.push(cur) }
            cur = ""
        } else {
            cur = cur + String::from_byte(c)
        }
        i = i + 1
    }
    if (cur.len() > 0) { out.push(cur) }
    return out
}

# ------------------------------------------------------------- fixture writing

# A one-package manifest with a version and the module body that answers
# `greet()` with `msg`.
manifest(name<String>, ver<String>)<String> -> {
    return "[package]\nname = \"" + name + "\"\nversion = \"" + ver + "\"\n"
}

# The published module: `greet()` returns `msg` prefixed with "hi-".
greeter(msg<String>)<String> -> {
    return "share(all)\ngreet()<String> -> { return \"hi-" + msg + "\" }\n"
}

# A consumer manifest with package name `pname` depending on `dep` with `spec`.
consumer_manifest(pname<String>, dep<String>, spec<String>)<String> -> {
    return "[package]\nname = \"" + pname + "\"\nversion = \"0.1.0\"\n\n[dependencies]\n" + dep + " = { version = \"" + spec + "\" }\n"
}

# A consumer program that imports `<dep>::greet` and prints it.
consumer_main(dep<String>)<String> -> {
    return "import " + dep + "::{greet}\nmain()<Int> -> {\n    s<String> = greet()\n    println(s)\n    return 0\n}\n"
}

# --------------------------------------------------------------- the check run

# Build `dir` with the compiler and given env, returning the exit code and the
# combined stdout+stderr.
build_in(exe<String>, dir<String>, stdlib<String>, reg<String>, outFile<String>)<Int> -> {
    cmd<String> = "cd '" + dir + "' && VYB_STDLIB='" + stdlib + "' VYB_REGISTRY='" + reg + "' timeout 300 " + exe + " build"
    cmd = cmd + " > " + outFile + " 2>&1; echo $?"
    return digits_to_int(run_sh(cmd))
}

main()<Int> -> {
    argv<Vec<String>> = argv_of()

    runner<String> = ""
    if (argv.len() > 1) { runner = argv.get(1) }
    repoRoot<String> = dirname_of(dirname_of(runner))
    if (repoRoot.len() == 0 || !exists(repoRoot + "/test")) { repoRoot = "." }

    exe<String> = ""
    if (argv.len() > 2 && exists(argv.get(2))) { exe = argv.get(2) }
    if (exe.len() == 0) { exe = repoRoot + "/build/vyb" }
    if (!exists(exe)) { exe = repoRoot + "/build-ci/vyb" }
    if (!exists(exe)) {
        println("registry smoke FAILED: no built `vyb` binary found (build/vyb or build-ci/vyb); pass a path")
        exit(1)
    }
    exe = absolute(exe, repoRoot)
    stdlib<String> = absolute(repoRoot + "/stdlib", repoRoot)

    tmp<String> = "/tmp/vybreg_sc"
    reg<String> = tmp + "/registry"
    run_sh("rm -rf '" + tmp + "' && mkdir -p '" + tmp + "'")

    # 1. publish 1.0.0 / 1.1.0 / 2.0.0 (the sibling versions exercise prefix selection)
    versions<Vec<String>> = Vec<String>()
    msgs<Vec<String>> = Vec<String>()
    versions.push("1.0.0"); msgs.push("v1")
    versions.push("1.1.0"); msgs.push("v11")
    versions.push("2.0.0"); msgs.push("v2")

    publishOk<Bool> = true
    k<Int> = 0
    while (k < versions.len()) {
        ver<String> = versions.get(k)
        pkg<String> = tmp + "/pkg_" + ver
        if (!ensure_dir(pkg)) { publishOk = false }
        if (!spill(pkg + "/vyb.toml", manifest("Gdemo", ver))) { publishOk = false }
        if (!spill(pkg + "/mod.vyb", greeter(msgs.get(k)))) { publishOk = false }
        rc<Int> = digits_to_int(run_sh("cd '" + repoRoot + "' && VYB_STDLIB='" + stdlib + "' VYB_REGISTRY='" + reg + "' timeout 300 " + exe + " mod publish '" + pkg + "' > " + tmp + "/pub.txt 2>&1; echo $?"))
        if (rc != 0) {
            publishOk = false
            println("publish " + ver + " FAILED:")
            println(slurp(tmp + "/pub.txt"))
        }
        k = k + 1
    }

    # 2. every published version dir must hold mod.vyb
    presentOk<Bool> = true
    k = 0
    while (k < versions.len()) {
        if (!exists(reg + "/Gdemo/" + versions.get(k) + "/mod.vyb")) {
            presentOk = false
            println("missing registry entry: Gdemo/" + versions.get(k) + "/mod.vyb")
        }
        k = k + 1
    }

    # 3. consumer with the prefix spec "1" -> highest 1.x (1.1.0)
    cons<String> = tmp + "/consumer"
    ensure_dir(cons + "/src")
    spill(cons + "/vyb.toml", consumer_manifest("consumer", "Gdemo", "1"))
    spill(cons + "/src/main.vyb", consumer_main("Gdemo"))
    rcA<Int> = build_in(exe, cons, stdlib, reg, tmp + "/buildA.txt")
    outA<String> = slurp(tmp + "/buildA.txt")
    prefixOk<Bool> = (rcA == 0) && (outA.index_of("Fetching Gdemo@1.1.0") >= 0)
    if (!prefixOk) {
        println("prefix-spec build FAILED (rc " + rcA.to_string() + "):")
        println(outA)
    }
    lockOk<Bool> = (slurp(cons + "/vyb.lock").index_of("source = \"version\"") >= 0)

    # 4. run the built binary -- it must print the 1.1.0 module's greeting
    runA<String> = ""
    if (rcA == 0) { runA = run_sh("timeout 60 '" + cons + "/target/consumer'") }
    runAOk<Bool> = (runA.index_of("hi-v11") >= 0)

    # 5. consumer with the exact spec "1.0.0"
    consB<String> = tmp + "/consumerB"
    ensure_dir(consB + "/src")
    spill(consB + "/vyb.toml", consumer_manifest("consumerB", "Gdemo", "1.0.0"))
    spill(consB + "/src/main.vyb", consumer_main("Gdemo"))
    rcB<Int> = build_in(exe, consB, stdlib, reg, tmp + "/buildB.txt")
    outB<String> = slurp(tmp + "/buildB.txt")
    exactOk<Bool> = (rcB == 0) && (outB.index_of("Fetching Gdemo@1.0.0") >= 0)
    if (!exactOk) {
        println("exact-spec build FAILED (rc " + rcB.to_string() + "):")
        println(outB)
    }
    runB<String> = ""
    if (rcB == 0) { runB = run_sh("timeout 60 '" + consB + "/target/consumerB'") }
    runBOk<Bool> = (runB.index_of("hi-v1") >= 0)

    names<Vec<String>> = Vec<String>()
    names.push("publish(3 versions)")
    names.push("registry layout(Gdemo/<ver>/mod.vyb)")
    names.push("prefix spec \"1\" -> 1.1.0")
    names.push("lockfile source=version")
    names.push("run(hi-v11)")
    names.push("exact spec 1.0.0")
    names.push("run(hi-v1)")

    results<Vec<Bool>> = Vec<Bool>()
    results.push(publishOk)
    results.push(presentOk)
    results.push(prefixOk)
    results.push(lockOk)
    results.push(runAOk)
    results.push(exactOk)
    results.push(runBOk)

    passed<Int> = 0
    bad<Int> = 0
    i<Int> = 0
    while (i < names.len()) {
        if (results.get(i)) {
            passed = passed + 1
        } else {
            println("  FAIL: " + names.get(i))
            bad = bad + 1
        }
        i = i + 1
    }

    if (bad > 0) {
        println("registry smoke FAILED: " + passed.to_string() + "/" + names.len().to_string() + " checks passed")
        exit(1)
    }

    println("registry smoke: " + names.len().to_string() + "/" + names.len().to_string() + " checks passed (publish, prefix->highest, lockfile source=version, run, exact)")
    return 0
}
