// @test: notype() Intrinsic with Structs
// @description: Tests the notype() intrinsic for suppressing type metadata in struct field names
// @category: intrinsic, json, serialization, struct
// @expect: pass
// @expect-output: [{"id": 123, "name": "Alice", "salary": 88000}, {"name": "Acme", "employeeCount": 150}]

// notype() forwards a struct value to the auto-serializer unchanged; since #375 the
// multi-value return path resolves each element's struct type, so the elements
// serialize as JSON objects with their field names instead of the old [null, null].

struct Person {
    Int id,
    String name,
    Float salary
}

struct Company {
    String name,
    Int employeeCount
}

main()<Person, Company> -> {
    person<Person> = Person { id = 123, name = "Alice", salary = 88000.0 };
    company<Company> = Company { name = "Acme", employeeCount = 150 };
    return notype(person), company;
}
