// @test: A reserved word as a typed variable name names the word
// @description: `fail` is a keyword, so `fail<Int> = 3` used to reach the fail-statement parser and
//   report "Expected '(' after typed fail" (and `match<Int> = 3` "Expected '(' after 'match'"),
//   neither of which says the name is the problem. The statement parser now says so.
// @category: parser, diagnostics
// @expect: fail
// @expect-error: 'fail' is a reserved word and cannot be used as a variable name

main()<Int> -> {
    fail<Int> = 3
    return fail
}
