// @test: if/else takes the else-branch
// @description: main()<i32> returns 99, so an executed Int main exits 99 (C exit() semantics); the expectation was undeclared, which the suite read as exit 0.
// @expect: pass
// @expect-return: 99
main()<i32> -> {
    x<i32> = 5;   // This is less than 10
    result<i32> = 0;

    if (x > 10) {
        result = 42;
    } else {
        result = 99;
    }

    return result;
}