// @test: network binary send/recv - Vec<UInt8> byte buffers over loopback TCP
// @description: the byte-buffer socket surface (socket_send_bytes(_range),
//   socket_recv_bytes(_exact), socket_exchange_bytes, TcpStream write_bytes/
//   read_bytes/read_bytes_exact) moves raw bytes -- NULs and high-bit bytes
//   included -- with no String detour. Covers exact and slice sends, the empty
//   send, a 60 KB payload, the exchange wire format (8-byte little-endian length
//   prefix), an oversized frame and an out-of-range slice (absent), and
//   end-of-stream (empty Vec from recv_bytes, absent from recv_bytes_exact).
// @category: modules, network, sockets, stdlib, binary, io
// @expect: pass
// @expect-output: netbytes-ok
// @expect-return: 0
// @env: VYB_STDLIB=stdlib

import network::{socket_open, socket_bind, socket_listen, socket_accept,
                 socket_connect, socket_local_port, socket_close, socket_error_code,
                 socket_send_bytes, socket_send_bytes_range, socket_recv_bytes,
                 socket_recv_bytes_exact, socket_exchange_bytes, Socket}

# Forward a read-only borrow through a user function (no copy of the caller's buffer).
send_window(fd<Int>, d<their<Vec<UInt8> const>>, off<Int>, len<Int>)<Int> -> {
    return socket_send_bytes_range(fd, d, off, len) else -1
}

main()<Int> -> {
    srv<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, 0) else -1
    if (srv < 0) { return 1 }
    if (!(socket_bind(srv, "127.0.0.1", 0) else false)) { return 2 }
    if (!(socket_listen(srv, 1) else false)) { return 3 }
    port<Int> = socket_local_port(srv) else -1
    cli<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, 0) else -1
    if (!(socket_connect(cli, "127.0.0.1", port) else false)) { return 4 }
    conn<Int> = socket_accept(srv) else -1
    if (conn < 0) { return 5 }

    # 1. Raw bytes, NUL + high bit, sent whole and received exactly.
    b<Vec<UInt8>> = Vec()
    b.push(0 as UInt8)
    b.push(255 as UInt8)
    b.push(1 as UInt8)
    b.push(7 as UInt8)
    b.push(66 as UInt8)
    if ((socket_send_bytes(cli, view(b)) else -1) != 5) { return 10 }
    match (socket_recv_bytes_exact(conn, 5)) {
        r -> {
            if (r.len() != 5) { return 11 }
            if ((r.get(0) as Int) != 0 || (r.get(1) as Int) != 255) { return 12 }
            if ((r.get(4) as Int) != 66) { return 13 }
        }
        ? -> { return 14 }
    }

    # 2. A window of a buffer: bytes [1, 4).
    if ((socket_send_bytes_range(cli, view(b), 1, 3) else -1) != 3) { return 20 }
    match (socket_recv_bytes_exact(conn, 3)) {
        r -> {
            if ((r.get(0) as Int) != 255 || (r.get(2) as Int) != 7) { return 21 }
        }
        ? -> { return 22 }
    }
    # Out-of-range slices are the absent Int?, and nothing is sent.
    if ((socket_send_bytes_range(cli, view(b), 3, 5) else -1) != -1) { return 23 }
    if ((socket_send_bytes_range(cli, view(b), -1, 1) else -1) != -1) { return 24 }
    if (socket_error_code() == 0) { return 25 }

    # 3. Empty buffer: present 0; an exact read of 0 bytes is the present empty Vec.
    empty<Vec<UInt8>> = Vec()
    if ((socket_send_bytes(cli, view(empty)) else -1) != 0) { return 30 }
    match (socket_recv_bytes_exact(conn, 0)) {
        r -> { if (r.len() != 0) { return 31 } }
        ? -> { return 32 }
    }

    # 4. A 60 KB patterned payload arrives intact through exact reassembly.
    big<Vec<UInt8>> = Vec()
    i<Int> = 0
    while (i < 60000) { big.push((i % 251) as UInt8) ; i = i + 1 }
    if ((socket_send_bytes(cli, view(big)) else -1) != 60000) { return 40 }
    match (socket_recv_bytes_exact(conn, 60000)) {
        r -> {
            if (r.len() != 60000) { return 41 }
            j<Int> = 0
            while (j < 60000) {
                if ((r.get(j) as Int) != j % 251) { return 42 }
                j = j + 7
            }
            if ((r.get(59999) as Int) != 59999 % 251) { return 43 }
        }
        ? -> { return 44 }
    }

    # 5. socket_recv_bytes is one read: it returns what is there, up to maxlen.
    if ((socket_send_bytes_range(cli, view(b), 0, 2) else -1) != 2) { return 50 }
    match (socket_recv_bytes(conn, 4096)) {
        r -> { if (r.len() < 1 || r.len() > 2) { return 51 } ;
               if (r.len() == 1) { socket_recv_bytes_exact(conn, 1) } }
        ? -> { return 52 }
    }

    # 6. Exchange wire format: the peer's frame is [len u64 LE][payload]. Pre-load
    #    the server side's frame so a single thread can drive both ends.
    fr<Vec<UInt8>> = Vec()
    fr.push(3 as UInt8)
    k<Int> = 0
    while (k < 7) { fr.push(0 as UInt8) ; k = k + 1 }
    fr.push(9 as UInt8)
    fr.push(8 as UInt8)
    fr.push(0 as UInt8)
    if ((socket_send_bytes(conn, view(fr)) else -1) != 11) { return 60 }
    out<Vec<UInt8>> = Vec()
    out.push(1 as UInt8)
    out.push(2 as UInt8)
    match (socket_exchange_bytes(cli, view(out), 16)) {
        r -> {
            if (r.len() != 3) { return 61 }
            if ((r.get(0) as Int) != 9 || (r.get(2) as Int) != 0) { return 62 }
        }
        ? -> { return 63 }
    }
    match (socket_recv_bytes_exact(conn, 10)) {
        r -> {
            if ((r.get(0) as Int) != 2) { return 64 }
            if ((r.get(7) as Int) != 0) { return 65 }
            if ((r.get(8) as Int) != 1 || (r.get(9) as Int) != 2) { return 66 }
        }
        ? -> { return 67 }
    }

    # 6b. A borrow forwarded through a user function sends the caller's live
    #     bytes: a write to the Vec after the first send shows up in the second.
    win<Vec<UInt8>> = Vec()
    win.push(5 as UInt8)
    win.push(6 as UInt8)
    win.push(7 as UInt8)
    if (send_window(cli, view(win), 1, 2) != 2) { return 68 }
    win.set(2, 42 as UInt8)
    if (send_window(cli, view(win), 1, 2) != 2) { return 69 }
    match (socket_recv_bytes_exact(conn, 4)) {
        r -> {
            if ((r.get(0) as Int) != 6 || (r.get(1) as Int) != 7) { return 72 }
            if ((r.get(2) as Int) != 6 || (r.get(3) as Int) != 42) { return 73 }
        }
        ? -> { return 74 }
    }

    # 7. A frame larger than max_in is refused (absent), not allocated.
    hdr<Vec<UInt8>> = Vec()
    hdr.push(100 as UInt8)
    k = 0
    while (k < 7) { hdr.push(0 as UInt8) ; k = k + 1 }
    socket_send_bytes(conn, view(hdr))
    absent<Bool> = false
    match (socket_exchange_bytes(cli, view(empty), 16)) {
        r -> { absent = false }
        ? -> { absent = true }
    }
    if (!absent) { return 70 }
    if (socket_error_code() == 0) { return 71 }
    socket_recv_bytes_exact(conn, 8)      # drain the empty frame cli sent

    # 8. End-of-stream: recv_bytes gives the present empty Vec, the exact read is
    #    absent.
    socket_close(cli)
    match (socket_recv_bytes(conn, 64)) {
        r -> { if (r.len() != 0) { return 80 } }
        ? -> { return 81 }
    }
    eofAbs<Bool> = false
    match (socket_recv_bytes_exact(conn, 1)) {
        r -> { eofAbs = false }
        ? -> { eofAbs = true }
    }
    if (!eofAbs) { return 82 }
    socket_close(conn)
    socket_close(srv)
    println("netbytes-ok")
    return 0
}
