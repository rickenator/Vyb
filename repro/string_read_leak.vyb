# repro/string_read_leak.vyb — does repeatedly reading a multi-MB file grow the heap?
#
# The GLM-53 prefill driver climbs ~3 GB of RSS per layer even after malloc_trim(0), which
# kills a 46-layer pass at layer 25 inside an 80 GB scope on a 125 GB host. Each MoE layer
# streams ~327 EXL3 tensors (~1.3 GB) through String buffers via read_at/read_all, so the
# prime suspect is that the String data is not returned to the allocator.
#
# This prints the RSS (from /proc/self/status) every N iterations, so a monotone climb is
# visible without any external sampling.
#
# MEASURED (clean build, 2026-10-30): 200 reads of a 4.17 MB file -> RSS 74 MB -> 891 MB,
# i.e. exactly one buffer leaked per read (4.1 MB). malloc_trim(0) per 50 iterations does
# not change it, so the pages are still REFERENCED, not fragmented. Reading a 4 KB file
# 3000 times grows RSS by ~9 kB/read, proportional to bytes -- same conclusion.
#
# String.vyb's declaration path registers the binding with needsCleanup=1 and does not
# retain when the initializer is a String-returning call, so the counter side is fine; the
# release never lands. This is what OOM-kills the GLM-53 prefill: every MoE layer streams
# ~327 EXL3 tensors (~1.3 GB) through String buffers, and a 46-layer pass leaks ~60 GB.
#
#   build/vyb repro/string_read_leak.vyb            # 4 MB file, 400 reads
#   VYB_LEAK_ITERS=2000 build/vyb repro/string_read_leak.vyb
import io::{open_read, read_all, close}
import env::{env_get}

extern "C" {
    malloc_trim(pad<Int>)<CInt>
}

# VmRSS in kB from /proc/self/status (0 when unreadable).
rss_kb()<Int> -> {
    t<String> = ""
    match (open_read("/proc/self/status")) {
        f -> { match (read_all(f)) { s -> { t = s } ? -> { } } close(f) }
        ? -> { return 0 }
    }
    i<Int> = 0
    while (i < t.len()) {
        if (i + 6 < t.len() && t.substring(i, i + 6) == "VmRSS:") {
            j<Int> = i + 6
            n<Int> = 0
            seen<Int> = 0
            while (j < t.len()) {
                c<Int> = (t.char_at(j) as Int) & 255
                if (c >= 48 && c <= 57) {
                    n = n * 10 + (c - 48)
                    seen = 1
                } else {
                    if (seen == 1) { return n }
                }
                j = j + 1
            }
            return n
        }
        i = i + 1
    }
    return 0
}

main()<Int> -> {
    path<String> = env_get("VYB_LEAK_FILE") else "native/out/gold_l3_streams0.txt"
    iters<String> = env_get("VYB_LEAK_ITERS") else "400"
    trim<Int> = 1
    n<Int> = iters.to_int()
    println("file=" + path + " iters=" + n.to_string())
    println("start rss=" + rss_kb().to_string() + " kB")

    i<Int> = 0
    bytes<Int> = 0
    while (i < n) {
        s<String> = ""
        match (open_read(path)) {
            f -> { match (read_all(f)) { r -> { s = r } ? -> { } } close(f) }
            ? -> { }
        }
        bytes = bytes + s.len()
        if (i % 50 == 49) {
            if (trim == 1) {
                freedom { malloc_trim(0) }
            }
            println("iter " + (i + 1).to_string() + " rss=" + rss_kb().to_string() +
                    " kB bytes=" + bytes.to_string())
        }
        i = i + 1
    }
    println("end rss=" + rss_kb().to_string() + " kB")
    return 0
}
