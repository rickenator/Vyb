cgen_prologue()<String> -> {
    return "        if (!rtName.empty()) {\n            auto getQtFn = [&](llvm::FunctionType* ft) -> llvm::Function* {\n                llvm::Function* f2 = module->getFunction(rtName);\n                if (!f2) f2 = llvm::Function::Create(ft, llvm::Function::ExternalLinkage, rtName, module.get());\n                return f2;\n            };\n            auto toI64 = [&](llvm::Value* v) -> llvm::Value* {\n                if (!v) return v;\n                if (v->getType()->isIntegerTy(64)) return v;\n                if (v->getType()->isIntegerTy())\n                    return builder->CreateSExt(v, int64Type, \"qt.toi64\");\n                return v;\n            };\n            auto toStrPtr = [&](llvm::Value* v) -> llvm::Value* {\n                if (v && v->getType()->isStructTy())\n                    return builder->CreateExtractValue(v, 0, \"qt.strptr\");\n                return v;\n            };\n            auto strLenOf = [&](llvm::Value* v) -> llvm::Value* {\n                if (v && v->getType()->isStructTy())\n                    return builder->CreateExtractValue(v, 1, \"qt.strlen\");\n                return llvm::ConstantInt::get(int64Type, 0);\n            };\n            auto qtStrRet = [&]() -> llvm::StructType* {\n                std::vector<llvm::Type*> f = {int8PtrType, int64Type};\n                return llvm::StructType::get(*context, f, false);\n            };\n            auto needArg = [&](size_t idx) -> llvm::Value* {\n                if (idx >= node->arguments.size()) { m_currentLLVMValue = nullptr; return nullptr; }\n                node->arguments[idx]->accept(*this);\n                return m_currentLLVMValue;\n            };\n            auto checkArity = [&](size_t n) -> bool {\n                if (node->arguments.size() != n) {\n                    logError(node->loc, rtName + \" expects \" + std::to_string(n) + \" argument(s)\");\n                    m_currentLLVMValue = nullptr;\n                    return false;\n                }\n                return true;\n            };\n"
}
# --------------------------------------------------------------- emit: regions

# Stub bodies for the core QT_FUNCS table (group "f").
emit_stub_funcs(rows<Vec<String>>)<String> -> {
    out<String> = ""
    i<Int> = 0
    while (i < rows.len()) {
        row<String> = rows.get(i)
        if (fld(row, 14) == "f") {
            out = out + stub_body(fld(row, 3), fld(row, 2), fld(row, 4), fld(row, 6)) + "\n"
        }
        i = i + 1
    }
    return out
}

# Stub bodies for the optional QtWebEngine table (group "w").
emit_web_stub_funcs(rows<Vec<String>>)<String> -> {
    out<String> = ""
    i<Int> = 0
    while (i < rows.len()) {
        row<String> = rows.get(i)
        if (fld(row, 14) == "w") {
            out = out + stub_body(fld(row, 3), fld(row, 2), fld(row, 4), fld(row, 6)) + "\n"
        }
        i = i + 1
    }
    return out
}

# Opt-shim stub bodies.
emit_opt_stub_funcs(rows<Vec<String>>)<String> -> {
    out<String> = ""
    i<Int> = 0
    while (i < rows.len()) {
        row<String> = rows.get(i)
        if (fld(row, 11).len() > 0) {
            out = out + stub_opt_body(fld(row, 12), fld(row, 3)) + "\n"
        }
        i = i + 1
    }
    return out
}

# The codegen dispatch block.
emit_cgen(rows<Vec<String>>, shaperows<Vec<String>>, bkeys<Vec<String>>, bvals<Vec<String>>, okeys<Vec<String>>, ovals<Vec<String>>)<String> -> {
    out<String> = ""
    out = out + "        const std::string& fname = identCallee->name;\n"
    out = out + "        std::string rtName;\n"
    i<Int> = 0
    while (i < rows.len()) {
        row<String> = rows.get(i)
        kw<String> = "else if"
        if (i == 0) { kw = "if" }
        out = out + "        " + kw + " (fname == \"" + fld(row, 1) + "\") rtName = \"" + fld(row, 2) + "\";\n"
        i = i + 1
    }
    i = 0
    while (i < rows.len()) {
        row<String> = rows.get(i)
        ov<String> = fld(row, 11)
        if (ov.len() > 0) {
            out = out + "        else if (fname == \"" + ov + "\") rtName = \"" + fld(row, 12) + "\";\n"
        }
        i = i + 1
    }
    out = out + cgen_prologue() + "\n"

    first<Bool> = true
    s<Int> = 0
    while (s < shaperows.len()) {
        shape<String> = shaperows.get(s)
        names<Vec<String>> = Vec<String>()
        i = 0
        while (i < rows.len()) {
            row<String> = rows.get(i)
            if (fld(row, 5) == shape) { names.push(fld(row, 1)) }
            i = i + 1
        }
        if (names.len() > 0) {
            cl<String> = cond_lines(names)
            if (first) {
                out = out + "            if (" + cl + ") {\n"
            } else {
                out = out + "            } else if (" + cl + ") {\n"
            }
            first = false
            body<String> = br_get(shape, bkeys, bvals)
            lines<Vec<String>> = body.split("\n")
            lim<Int> = lines.len()
            if (lim > 0 && lines.get(lim - 1).len() == 0) { lim = lim - 1 }
            j<Int> = 0
            while (j < lim) {
                out = out + "                " + lines.get(j) + "\n"
                j = j + 1
            }
            out = out + "                return;\n"
        }
        s = s + 1
    }
    if (first == false) { out = out + "            }\n" }

    oshapes<Vec<String>> = Vec<String>()
    i = 0
    while (i < rows.len()) {
        row<String> = rows.get(i)
        if (fld(row, 11).len() > 0) {
            os<String> = fld(row, 13)
            seen<Bool> = false
            k<Int> = 0
            while (k < oshapes.len()) {
                if (oshapes.get(k) == os) { seen = true }
                k = k + 1
            }
            if (!seen) { oshapes.push(os) }
        }
        i = i + 1
    }
    ofirst<Bool> = true
    s = 0
    while (s < oshapes.len()) {
        oshape<String> = oshapes.get(s)
        names<Vec<String>> = Vec<String>()
        i = 0
        while (i < rows.len()) {
            row<String> = rows.get(i)
            if (fld(row, 11).len() > 0 && fld(row, 13) == oshape) { names.push(fld(row, 11)) }
            i = i + 1
        }
        if (names.len() > 0) {
            cl<String> = cond_lines(names)
            if (ofirst) {
                out = out + "            if (" + cl + ") {\n"
            } else {
                out = out + "            } else if (" + cl + ") {\n"
            }
            ofirst = false
            body<String> = br_get(oshape, okeys, ovals)
            lines<Vec<String>> = body.split("\n")
            lim<Int> = lines.len()
            if (lim > 0 && lines.get(lim - 1).len() == 0) { lim = lim - 1 }
            j<Int> = 0
            while (j < lim) {
                out = out + "                " + lines.get(j) + "\n"
                j = j + 1
            }
            out = out + "                return;\n"
        }
        s = s + 1
    }
    if (ofirst == false) { out = out + "            }\n" }
    out = out + "        }\n"
    return out
}

# Semantic allow-list (`name == "..." || ...) {`).
emit_sem_allow(rows<Vec<String>>)<String> -> {
    names<Vec<String>> = Vec<String>()
    i<Int> = 0
    while (i < rows.len()) {
        names.push(fld(rows.get(i), 1))
        i = i + 1
    }
    i = 0
    while (i < rows.len()) {
        ov<String> = fld(rows.get(i), 11)
        if (ov.len() > 0) { names.push(ov) }
        i = i + 1
    }
    out<String> = ""
    i = 0
    while (i < names.len()) {
        joined<String> = "name == \"" + names.get(i) + "\""
        if (i + 1 < names.len()) { joined = joined + " || name == \"" + names.get(i + 1) + "\"" }
        if (i + 2 < names.len()) {
            out = out + "            " + joined + " ||\n"
        } else {
            out = out + "            " + joined + ") {\n"
        }
        i = i + 2
    }
    return out
}

# Int-classification name list.
emit_sem_int(rows<Vec<String>>)<String> -> {
    out<String> = ""
    i<Int> = 0
    while (i < rows.len()) {
        out = out + "                \"" + fld(rows.get(i), 1) + "\",\n"
        i = i + 1
    }
    return out
}

# String-classification name list.
emit_sem_str(rows<Vec<String>>)<String> -> {
    out<String> = ""
    i<Int> = 0
    while (i < rows.len()) {
        row<String> = rows.get(i)
        if (fld(row, 4) == "String") {
            out = out + "                \"" + fld(row, 1) + "\",\n"
        }
        i = i + 1
    }
    return out
}

# main.cpp extern declarations.
emit_main_decl(rows<Vec<String>>)<String> -> {
    out<String> = ""
    i<Int> = 0
    while (i < rows.len()) {
        row<String> = rows.get(i)
        retty<String> = "int64_t"
        if (fld(row, 4) == "String") { retty = "vyb_file_str" }
        out = out + "    " + retty + " " + fld(row, 2) + "(" + cpp_args(fld(row, 3)) + ");\n"
        i = i + 1
    }
    i = 0
    while (i < rows.len()) {
        row<String> = rows.get(i)
        if (fld(row, 11).len() > 0) {
            out = out + "    int64_t " + fld(row, 12) + "(" + cpp_opt_args(fld(row, 3), "vyb_file_str") + ");\n"
        }
        i = i + 1
    }
    return out
}

# main.cpp JIT symbol registration.
emit_main_reg(rows<Vec<String>>)<String> -> {
    out<String> = ""
    i<Int> = 0
    while (i < rows.len()) {
        cn<String> = fld(rows.get(i), 2)
        out = out + "        runtimeSymbols[mangle(\"" + cn + "\")] = llvm::orc::ExecutorSymbolDef(\n"
        out = out + "            llvm::orc::ExecutorAddr::fromPtr(&" + cn + "), llvm::JITSymbolFlags::Exported);\n"
        i = i + 1
    }
    i = 0
    while (i < rows.len()) {
        row<String> = rows.get(i)
        if (fld(row, 11).len() > 0) {
            ocn<String> = fld(row, 12)
            out = out + "        runtimeSymbols[mangle(\"" + ocn + "\")] = llvm::orc::ExecutorSymbolDef(\n"
            out = out + "            llvm::orc::ExecutorAddr::fromPtr(&" + ocn + "), llvm::JITSymbolFlags::Exported);\n"
        }
        i = i + 1
    }
    return out
}

# stdlib/qt/mod.vyb enums.
emit_mod_enums(evrows<Vec<String>>, wsrows<Vec<String>>)<String> -> {
    out<String> = "share(all)\nenum QtEvent {\n"
    i<Int> = 0
    while (i < evrows.len()) {
        parts<Vec<String>> = evrows.get(i).split("|")
        out = out + "    " + parts.get(0) + " = " + parts.get(1) + "\n"
        i = i + 1
    }
    out = out + "}"
    out = out + "\n\n"
    out = out + "share(all)\nenum QtWidgetKind {\n"
    i = 0
    while (i < wsrows.len()) {
        parts<Vec<String>> = wsrows.get(i).split("|")
        out = out + "    " + parts.get(0) + " = " + parts.get(1) + "\n"
        i = i + 1
    }
    out = out + "}"
    return out
}

# stdlib/qt/mod.vyb public wrappers (+ documents).
emit_mod_wrappers(rows<Vec<String>>, mrows<Vec<String>>)<String> -> {
    out<String> = ""
    i<Int> = 0
    while (i < rows.len()) {
        row<String> = rows.get(i)
        out = out + "# " + fld(row, 7) + "\n"
        out = out + "share(all)\n"
        sig<String> = fld(row, 9)
        if (sig.len() == 0) { sig = join_sig(fld(row, 3)) }
        retty<String> = fld(row, 4)
        ov<String> = fld(row, 11)
        mt<String> = ""
        if (ov.len() > 0) {
            retty = "String?"
        } else {
            mt = mig_target(fld(row, 0), mrows)
            if (mt.len() > 0) { retty = base_of(mt) }
        }
        out = out + fld(row, 0) + "(" + sig + ")<" + retty + "> -> {\n"
        bl<String> = ""
        if (ov.len() > 0) {
            bl = "    return " + ov + "(" + join_names(fld(row, 3)) + ")"
        } else if (mt.len() > 0) {
            bl = "    " + migrate_body(fld(row, 3), fld(row, 1), mt)
        } else if (fld(row, 10).len() > 0) {
            bl = "    " + fld(row, 10)
        } else if (fld(row, 8).len() > 0) {
            bl = "    " + fld(row, 8)
        } else {
            bl = "    return " + fld(row, 1) + "(" + join_names(fld(row, 3)) + ")"
            if (fld(row, 4) == "Bool") { bl = bl + " == 1" }
        }
        out = out + bl + "\n"
        out = out + "}\n\n"
        i = i + 1
    }
    return out
}

# ------------------------------------------------------------------------ main

main()<Void> -> {
    argv<Vec<String>> = argv_of()
    # `--check` is the canonical drift flag (same as tools/gen_qt.py). This
    # compiler reserves a bare `--check` for its own `vyb --format --check`
    # formatter gate and consumes it before any program runs, so the aliases
    # `--check-regions` / `--check-drift` are accepted for the same read-only
    # drift report when invoked through build/vyb.
    check<Bool> = (has(argv, "--check") || has(argv, "--check-regions") || has(argv, "--check-drift"))
    root<String> = repo_root(argv)

    rows<Vec<String>> = t_rows()
    mrows<Vec<String>> = mig_rows()
    shaperows<Vec<String>> = shape_rows()
    bkeys<Vec<String>> = branch_keys()
    bvals<Vec<String>> = branch_vals()
    okeys<Vec<String>> = optbranch_keys()
    ovals<Vec<String>> = optbranch_vals()
    evrows<Vec<String>> = ev_rows()
    wsrows<Vec<String>> = ws_rows()

    drift<Bool> = false

    r<Int> = do_region(root, "runtime/vyb_qt_stub.cpp", "cpp", "stub", emit_stub_funcs(rows), check)
    if (r == 1) { drift = true }
    r = do_region(root, "runtime/vyb_qt_stub.cpp", "cpp", "web_stub", emit_web_stub_funcs(rows), check)
    if (r == 1) { drift = true }
    r = do_region(root, "runtime/vyb_qt_stub.cpp", "cpp", "opt_stub", emit_opt_stub_funcs(rows), check)
    if (r == 1) { drift = true }
    r = do_region(root, "src/vre/llvm/cgen_expr.cpp", "cpp", "cgen", emit_cgen(rows, shaperows, bkeys, bvals, okeys, ovals), check)
    if (r == 1) { drift = true }
    r = do_region(root, "src/vre/semantic.cpp", "cpp", "sem_allow", emit_sem_allow(rows), check)
    if (r == 1) { drift = true }
    r = do_region(root, "src/vre/semantic.cpp", "cpp", "sem_int", emit_sem_int(rows), check)
    if (r == 1) { drift = true }
    r = do_region(root, "src/vre/semantic.cpp", "cpp", "sem_str", emit_sem_str(rows), check)
    if (r == 1) { drift = true }
    r = do_region(root, "src/main.cpp", "cpp", "main_decl", emit_main_decl(rows), check)
    if (r == 1) { drift = true }
    r = do_region(root, "src/main.cpp", "cpp", "main_reg", emit_main_reg(rows), check)
    if (r == 1) { drift = true }
    r = do_region(root, "stdlib/qt/mod.vyb", "vyb", "mod_enums", emit_mod_enums(evrows, wsrows), check)
    if (r == 1) { drift = true }
    r = do_region(root, "stdlib/qt/mod.vyb", "vyb", "mod_wrappers", emit_mod_wrappers(rows, mrows), check)
    if (r == 1) { drift = true }

    if (check) {
        if (drift) {
            println("gen_qt: DRIFT - run `python3 tools/gen_qt.py` to regenerate")
            exit(1)
        }
        println("gen_qt: OK (state matches the table)")
        exit(0)
    }
    if (!drift) { println("gen_qt: no changes (state matches the table)") }
    exit(0)
}
