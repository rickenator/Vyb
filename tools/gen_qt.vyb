// @not-a-test: true
# gen_qt.vyb - table-driven generator for the stdlib `qt` module's mechanical layers.
#
# Vyb port of `tools/gen_qt.py`. The hand-written C++ logic lives in
# runtime/vyb_qt_bridge.cpp; everything else -- the stub fallback, the codegen
# dispatch, the semantic allow-list and Int/String classification, the JIT symbol
# registration, and the Vyb wrappers + enums -- is owned by this tool and driven
# by the QT_FUNCS / QT_EVENTS / QT_WIDGETS table (embedded below, generated from
# the Python source of truth). Each owned region is delimited by sentinel
# comments (`gen_qt[<key>]: begin` / `end`) whose body this tool rewrites in
# place. `--check` verifies no owned region drifted.
#
# Usage:
#   VYB_STDLIB=$PWD/stdlib build/vyb tools/gen_qt.vyb            # regenerate in place
#   VYB_STDLIB=$PWD/stdlib build/vyb tools/gen_qt.vyb --check    # exit 1 if any region is stale
#
# The repo root is derived from this program's own path (argv[1]); run it from
# anywhere with an absolute path, or as `tools/gen_qt.vyb` from the repo root.
// @not-a-test: true
import io::{close, open_read, open_write, read_all, write_str}
import process::{exec_output}

# ---------------------------------------------------------------- small helpers

# Index of the last '/' in `p`, or -1.
last_slash(p<String>)<Int> -> {
    i<Int> = p.len() - 1
    while (i >= 0) {
        if (((p.char_at(i) as Int) & 0xFF) == 47) { return i }
        i = i - 1
    }
    return -1
}

# Directory part of `p` ("" when there is no slash).
dirname_of(p<String>)<String> -> {
    i<Int> = last_slash(p)
    if (i < 0) { return "" }
    return p.substring(0, i)
}

# Strip leading/trailing whitespace (space, tab, CR, LF) from `s`.
trim(s<String>)<String> -> {
    a<Int> = 0
    n<Int> = s.len()
    while (a < n) {
        c<Int> = (s.char_at(a) as Int) & 0xFF
        if (c == 32 || c == 9 || c == 13 || c == 10) { a = a + 1 } else { break }
    }
    b<Int> = n
    while (b > a) {
        c<Int> = (s.char_at(b - 1) as Int) & 0xFF
        if (c == 32 || c == 9 || c == 13 || c == 10) { b = b - 1 } else { break }
    }
    if (b <= a) { return "" }
    return s.substring(a, b)
}

# Strip trailing whitespace only (Python's str.rstrip() with no args).
rstrip_ws(s<String>)<String> -> {
    b<Int> = s.len()
    while (b > 0) {
        c<Int> = (s.char_at(b - 1) as Int) & 0xFF
        if (c == 32 || c == 9 || c == 13 || c == 10) { b = b - 1 } else { break }
    }
    return s.substring(0, b)
}

# Strip trailing newlines only (Python's str.rstrip("\n")).
rstrip_nl(s<String>)<String> -> {
    b<Int> = s.len()
    while (b > 0) {
        if (((s.char_at(b - 1) as Int) & 0xFF) == 10) { b = b - 1 } else { break }
    }
    return s.substring(0, b)
}

# Decimal value of a digit string (stops at the first non-digit; handles a
# leading '-'). This build has no String::to_int.
digits_to_int(s<String>)<Int> -> {
    t<String> = trim(s)
    n<Int> = 0
    neg<Bool> = false
    i<Int> = 0
    if (t.len() > 0 && (((t.char_at(0) as Int) & 0xFF) == 45)) { neg = true; i = 1 }
    while (i < t.len()) {
        c<Int> = (t.char_at(i) as Int) & 0xFF
        if (c < 48 || c > 57) { break }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    if (neg) { return 0 - n }
    return n
}

# True when `s` is an optional-minus integer literal.
stub_is_num(s<String>)<Bool> -> {
    t<String> = s
    if (t.len() > 0 && (((t.char_at(0) as Int) & 0xFF) == 45)) { t = t.substring(1, t.len()) }
    if (t.len() == 0) { return false }
    i<Int> = 0
    while (i < t.len()) {
        c<Int> = (t.char_at(i) as Int) & 0xFF
        if (c < 48 || c > 57) { return false }
        i = i + 1
    }
    return true
}

# Index at/after `start` where `needle` first occurs in `text`, or -1.
find_from(text<String>, needle<String>, start<Int>)<Int> -> {
    if (start >= text.len()) { return -1 }
    if (needle.len() == 0) { return start }
    sub<String> = text.substring(start, text.len())
    p<Int> = sub.index_of(needle)
    if (p < 0) { return -1 }
    return start + p
}

# Index of the first LF at/after `start`, or -1.
next_lf(text<String>, start<Int>)<Int> -> {
    i<Int> = start
    while (i < text.len()) {
        if (((text.char_at(i) as Int) & 0xFF) == 10) { return i }
        i = i + 1
    }
    return -1
}

# True when `flag` appears in `argv`.
has(argv<Vec<String>>, flag<String>)<Bool> -> {
    i<Int> = 0
    while (i < argv.len()) {
        if (argv.get(i) == flag) { return true }
        i = i + 1
    }
    return false
}

# The program's argv, parsed from `/proc/self/cmdline` (NUL separated).
argv_of()<Vec<String>> -> {
    raw<String> = slurp("/proc/self/cmdline")
    out<Vec<String>> = Vec<String>()
    cur<String> = ""
    i<Int> = 0
    while (i < raw.len()) {
        c<Int> = (raw.char_at(i) as Int) & 0xFF
        if (c == 0) {
            if (cur.len() > 0) { out.push(cur) }
            cur = ""
        } else {
            cur = cur + String::from_byte(c)
        }
        i = i + 1
    }
    if (cur.len() > 0) { out.push(cur) }
    return out
}

# Read a whole file as a String ("" when it cannot be read).
slurp(path<String>)<String> -> {
    text<String> = ""
    match (open_read(path)) {
        f -> {
            match (read_all(f)) { s -> { text = s } ? -> { } }
            close(f)
        }
        ? -> { }
    }
    return text
}

# Write `text` to `path`; true when the whole string was written.
spill(path<String>, text<String>)<Bool> -> {
    match (open_write(path)) {
        f -> {
            match (write_str(f, text)) { n -> { close(f); return (n == text.len()) } ? -> { close(f); return false } }
        }
        ? -> { return false }
    }
    return false
}

# Repo root derived from this program's own path: dirname(dirname(argv[1])).
repo_root(argv<Vec<String>>)<String> -> {
    prog<String> = ""
    if (argv.len() > 1) { prog = argv.get(1) }
    if (prog.len() == 0) { return "." }
    root<String> = dirname_of(dirname_of(prog))
    if (root.len() == 0) { root = "." }
    return root
}

# ------------------------------------------------------- table-field accessors

# Field `k` of a `|`-separated table row.
fld(row<String>, k<Int>)<String> -> {
    parts<Vec<String>> = row.split("|")
    if (k >= 0 && k < parts.len()) { return parts.get(k) }
    return ""
}

# Argument names of a "name:Type, name:Type" arg string.
arg_names(argstr<String>)<Vec<String>> -> {
    out<Vec<String>> = Vec<String>()
    if (argstr.len() > 0) {
        pairs<Vec<String>> = argstr.split(",")
        i<Int> = 0
        while (i < pairs.len()) {
            p<String> = trim(pairs.get(i))
            c<Int> = p.index_of(":")
            if (c >= 0) { out.push(p.substring(0, c)) }
            i = i + 1
        }
    }
    return out
}

# Argument Vyb types of a "name:Type, name:Type" arg string.
arg_types(argstr<String>)<Vec<String>> -> {
    out<Vec<String>> = Vec<String>()
    if (argstr.len() > 0) {
        pairs<Vec<String>> = argstr.split(",")
        i<Int> = 0
        while (i < pairs.len()) {
            p<String> = trim(pairs.get(i))
            c<Int> = p.index_of(":")
            if (c >= 0) { out.push(p.substring(c + 1, p.len())) }
            i = i + 1
        }
    }
    return out
}

# Names joined with ", ".
join_names(argstr<String>)<String> -> {
    names<Vec<String>> = arg_names(argstr)
    out<String> = ""
    i<Int> = 0
    while (i < names.len()) {
        if (i > 0) { out = out + ", " }
        out = out + names.get(i)
        i = i + 1
    }
    return out
}

# "name<Type>, name<Type>" for the default wrapper signature.
join_sig(argstr<String>)<String> -> {
    names<Vec<String>> = arg_names(argstr)
    types<Vec<String>> = arg_types(argstr)
    out<String> = ""
    i<Int> = 0
    while (i < names.len()) {
        if (i > 0) { out = out + ", " }
        out = out + names.get(i) + "<" + types.get(i) + ">"
        i = i + 1
    }
    return out
}

# First Bool-typed argument name, or "".
first_bool(argstr<String>)<String> -> {
    names<Vec<String>> = arg_names(argstr)
    types<Vec<String>> = arg_types(argstr)
    i<Int> = 0
    while (i < names.len()) {
        if (types.get(i) == "Bool") { return names.get(i) }
        i = i + 1
    }
    return ""
}

# C argument list; `outtype` (when non-empty) appends `<outtype>* out`.
cpp_args_impl(argstr<String>, outtype<String>)<String> -> {
    names<Vec<String>> = arg_names(argstr)
    types<Vec<String>> = arg_types(argstr)
    out<String> = ""
    lens<Int> = 0
    i<Int> = 0
    while (i < names.len()) {
        t<String> = types.get(i)
        piece<String> = ""
        if (t == "String") {
            ln<String> = "len"
            if (lens > 0) { ln = "len" + (lens + 1).to_string() }
            lens = lens + 1
            piece = "const char* " + names.get(i) + ", int64_t " + ln
        } else if (t == "Ptr") {
            piece = "void* " + names.get(i)
        } else {
            piece = "int64_t " + names.get(i)
        }
        if (i > 0) { out = out + ", " }
        out = out + piece
        i = i + 1
    }
    if (outtype.len() > 0) {
        if (out.len() > 0) { out = out + ", " }
        out = out + outtype + "* out"
    }
    return out
}

cpp_args(argstr<String>)<String> -> {
    return cpp_args_impl(argstr, "")
}

cpp_opt_args(argstr<String>, outtype<String>)<String> -> {
    return cpp_args_impl(argstr, outtype)
}

# "(void)a; (void)b" -- the cast statements that silence unused-parameter warnings.
void_casts(argstr<String>)<String> -> {
    names<Vec<String>> = arg_names(argstr)
    out<String> = ""
    i<Int> = 0
    while (i < names.len()) {
        if (i > 0) { out = out + " " }
        out = out + "(void)" + names.get(i) + ";"
        i = i + 1
    }
    return out
}

# One stub function body for a QT table row.
stub_body(argstr<String>, cn<String>, ret<String>, stub<String>)<String> -> {
    retty<String> = "int64_t"
    if (ret == "String") { retty = "vyb_qt_str" }
    sig<String> = "VYB_WEAK " + retty + " " + cn + "(" + cpp_args(argstr) + ")"
    expr<String> = "return qt_stub_str();"
    if (stub_is_num(stub)) { expr = "return " + stub + ";" }
    casts<String> = void_casts(argstr)
    inner<String> = expr
    if (casts.len() > 0) { inner = casts + " " + expr }
    nargs<Vec<String>> = arg_names(argstr)
    if (nargs.len() > 1 || retty == "vyb_qt_str") {
        return sig + "\n    { " + inner + " }"
    }
    return sig + " { " + inner + " }"
}

# One lossless opt-shim stub body (`vyb_qt_str* out` out-param, returns 0).
stub_opt_body(cn<String>, argstr<String>)<String> -> {
    names<Vec<String>> = arg_names(argstr)
    casts<String> = ""
    i<Int> = 0
    while (i < names.len()) {
        casts = casts + "(void)" + names.get(i) + "; "
        i = i + 1
    }
    casts = casts + "(void)out; "
    sig<String> = "VYB_WEAK int64_t " + cn + "(" + cpp_opt_args(argstr, "vyb_qt_str") + ")"
    return sig + "\n    { " + casts + "return 0; }"
}

# The `fname == "a"` disjunction for a shape group, wrapped like the Python tool
# (indent 16, break to a new line when indent+line+add would exceed 100 columns).
cond_lines(names<Vec<String>>)<String> -> {
    if (names.len() == 0) { return "" }
    line<String> = "fname == \"" + names.get(0) + "\""
    i<Int> = 1
    while (i < names.len()) {
        add<String> = " || fname == \"" + names.get(i) + "\""
        if (("                " + line + add).len() > 100) {
            line = line + " ||\n                fname == \"" + names.get(i) + "\""
        } else {
            line = line + add
        }
        i = i + 1
    }
    return line
}

# Body text for a branch key, or "".
br_get(key<String>, keys<Vec<String>>, vals<Vec<String>>)<String> -> {
    i<Int> = 0
    while (i < keys.len()) {
        if (keys.get(i) == key) { return vals.get(i) }
        i = i + 1
    }
    return ""
}

# MIGRATION target (e.g. "Int?@-1") for a wrapper name, or "".
mig_target(mod<String>, mrows<Vec<String>>)<String> -> {
    i<Int> = 0
    while (i < mrows.len()) {
        parts<Vec<String>> = mrows.get(i).split("|")
        if (parts.len() >= 2 && parts.get(0) == mod) { return parts.get(1) }
        i = i + 1
    }
    return ""
}

# The base return type of a MIGRATION target ("Int?@-1" -> "Int?").
base_of(target<String>)<String> -> {
    idx<Int> = target.index_of("@")
    if (idx >= 0) { return target.substring(0, idx) }
    return target
}

# Render an intrinsic call, coercing Bool args to 1/0 (intrinsics take Int).
qt_call(argstr<String>, vn<String>, truthy<Bool>)<String> -> {
    names<Vec<String>> = arg_names(argstr)
    types<Vec<String>> = arg_types(argstr)
    out<String> = ""
    i<Int> = 0
    while (i < names.len()) {
        if (i > 0) { out = out + ", " }
        if (types.get(i) == "Bool") {
            if (truthy) { out = out + "1" } else { out = out + "0" }
        } else {
            out = out + names.get(i)
        }
        i = i + 1
    }
    return vn + "(" + out + ")"
}

# Public-wrapper body for a migrated (T?) function.
migrate_body(argstr<String>, vn<String>, target<String>)<String> -> {
    base<String> = base_of(target)
    sent<String> = "0"
    idx<Int> = target.index_of("@")
    if (idx >= 0) { sent = target.substring(idx + 1, target.len()) }
    if (base == "Int?") {
        if (sent.len() == 0) { sent = "0" }
        return "v = " + qt_call(argstr, vn, false) + "\n    if (v == " + sent + ") { return Int?() }\n    return Int?(v)"
    }
    bn<String> = first_bool(argstr)
    if (bn.len() == 0) {
        return "if (" + qt_call(argstr, vn, false) + " != 0) { return Bool?() }\n    return Bool?(true)"
    }
    return "if (" + bn + ") {\n        if (" + qt_call(argstr, vn, true) + " != 0) { return Bool?() }\n        return Bool?(true)\n    }\n    if (" + qt_call(argstr, vn, false) + " != 0) { return Bool?() }\n    return Bool?(true)"
}

# ------------------------------------------------------------- marker/region IO

marker(lang<String>, key<String>, which<String>)<String> -> {
    if (lang == "cpp") { return "// gen_qt[" + key + "]: " + which }
    return "# gen_qt[" + key + "]: " + which
}

# Rewrite one owned region in `rel`; returns 1 when it drifted, else 0. In
# --check mode the file is never written.
do_region(root<String>, rel<String>, lang<String>, key<String>, body<String>, check<Bool>)<Int> -> {
    path<String> = root + "/" + rel
    text<String> = slurp(path)
    bm<String> = marker(lang, key, "begin")
    em<String> = marker(lang, key, "end")
    b<Int> = find_from(text, bm, 0)
    if (b < 0) {
        println("gen_qt: missing begin marker \"" + bm + "\"")
        exit(1)
    }
    e<Int> = find_from(text, em, b)
    if (e < 0) {
        println("gen_qt: missing end marker \"" + em + "\"")
        exit(1)
    }
    nl<Int> = next_lf(text, b)
    if (nl < 0) {
        println("gen_qt: missing begin marker \"" + bm + "\"")
        exit(1)
    }
    bstart<Int> = nl + 1
    body2<String> = rstrip_nl(body) + "\n"
    if (text.substring(bstart, e) == body2) { return 0 }
    if (check) { return 1 }
    newtext<String> = text.substring(0, bstart) + body2 + text.substring(e, text.len())
    spill(path, newtext)
    println("gen_qt: regenerated " + rel + " [" + key + "]")
    return 1
}
# ----- generated data (source of truth: tools/gen_qt.py) -----
t_rows()<Vec<String>> -> {
    v<Vec<String>> = Vec<String>()
    v.push("qt_web_create|vyb_qt_web_create|__vyb_qt_web_create|parent:Int|Int|int1|0|Create a QWebEngineView under `parent`. Returns `Int?` -- present with the live handle, absent if QtWebEngine is unavailable or creation failed.|||||||w")
    v.push("qt_web_load|vyb_qt_web_load|__vyb_qt_web_load|web:Int, url:String|Int|text|-1|Begin loading `url` in the web view (async). Returns `Bool?` -- present on success, absent on a bad handle.|||||||w")
    v.push("qt_web_url|vyb_qt_web_url|__vyb_qt_web_url|web:Int|String|str1|qt_stub_str()|Current page URL (String); \"\" on a bad handle.|||||||w")
    v.push("qt_web_title|vyb_qt_web_title|__vyb_qt_web_title|web:Int|String|str1|qt_stub_str()|Current page title (String); \"\" on a bad handle.|||||||w")
    v.push("qt_web_loading|vyb_qt_web_loading|__vyb_qt_web_loading|web:Int|Bool|int1|0|true while the page is still loading.|||||||w")
    v.push("qt_web_back|vyb_qt_web_back|__vyb_qt_web_back|web:Int|Int|int1|-1|Go back in history. Returns `Bool?` -- present on success, absent on a bad handle.|||||||w")
    v.push("qt_web_forward|vyb_qt_web_forward|__vyb_qt_web_forward|web:Int|Int|int1|-1|Go forward in history. Returns `Bool?` -- present on success, absent on a bad handle.|||||||w")
    v.push("qt_web_reload|vyb_qt_web_reload|__vyb_qt_web_reload|web:Int|Int|int1|-1|Reload the page. Returns `Bool?` -- present on success, absent on a bad handle.|||||||w")
    v.push("qt_web_zoom_in|vyb_qt_web_zoom_in|__vyb_qt_web_zoom_in|web:Int|Int|int1|-1|Zoom the web view in (larger text). Returns `Bool?` -- present on success, absent on a bad handle.|||||||w")
    v.push("qt_web_zoom_out|vyb_qt_web_zoom_out|__vyb_qt_web_zoom_out|web:Int|Int|int1|-1|Zoom the web view out (smaller text). Returns `Bool?` -- present on success, absent on a bad handle.|||||||w")
    v.push("qt_init|vyb_qt_init|__vyb_qt_init||Bool|int0|0|Initialize the QApplication (once); true if the GUI is available.|||||||f")
    v.push("qt_quit|vyb_qt_quit|__vyb_qt_quit||Int|int0|0|Shut the GUI down (terminal - do not use Qt handles afterwards). Returns `Bool?` -- present once the GUI has quit.|||||||f")
    v.push("qt_active|vyb_qt_active|__vyb_qt_active||Bool|int0|0|true while the GUI is initialized.|||||||f")
    v.push("qt_process_events|vyb_qt_process_events|__vyb_qt_process_events||Int|int0|-1|Pump the Qt event loop once. Returns `Bool?` -- present on success, absent if the GUI is not running.|||||||f")
    v.push("qt_set_timer|vyb_qt_set_timer|__vyb_qt_set_timer|ms:Int|Int|int1|-1|Arm a repeating timer every `ms` ms; poll qt_timer_fired(). Returns `Bool?` -- present on success, absent on failure.|||||||f")
    v.push("qt_timer_fired|vyb_qt_timer_fired|__vyb_qt_timer_fired||Bool|int0|0|true once the armed timer has fired since the last check (read clears).|||||||f")
    v.push("qt_window_create|vyb_qt_window_create|__vyb_qt_window_create||Int|int0|0|Create a top-level window. Returns `Int?` -- present with the live handle, absent if creation failed.|||||||f")
    v.push("qt_window_close|vyb_qt_window_close|__vyb_qt_window_close|w:Int|Int|int1|-1|Destroy window `w` (children go with it). Returns `Bool?` -- present on success, absent on a bad handle.|||||||f")
    v.push("qt_window_set_title|vyb_qt_window_set_title|__vyb_qt_window_set_title|w:Int, title:String|Int|text|-1|Set titlebar text. Returns `Bool?` -- present on success, absent on a bad handle.|||||||f")
    v.push("qt_window_title|vyb_qt_window_title|__vyb_qt_window_title|w:Int|String|str1|qt_stub_str()|Current titlebar text (String); \"\" on a bad handle.|||||||f")
    v.push("qt_window_resize|vyb_qt_window_resize|__vyb_qt_window_resize|w:Int, width:Int, height:Int|Int|3int|-1|Resize to (width, height) pixels. Returns `Bool?` -- present on success, absent on a bad handle.|||||||f")
    v.push("qt_window_width|vyb_qt_window_width|__vyb_qt_window_width|w:Int|Int|int1|-1|Content width in pixels. Returns `Int?` -- present holding the width, absent on a bad handle.|||||||f")
    v.push("qt_window_height|vyb_qt_window_height|__vyb_qt_window_height|w:Int|Int|int1|-1|Content height in pixels. Returns `Int?` -- present holding the height, absent on a bad handle.|||||||f")
    v.push("qt_window_show|vyb_qt_window_show|__vyb_qt_window_show|w:Int|Int|int1|-1|Show (map) the window. Returns `Bool?` -- present on success, absent on a bad handle.|||||||f")
    v.push("qt_window_hide|vyb_qt_window_hide|__vyb_qt_window_hide|w:Int|Int|int1|-1|Hide (unmap) the window. Returns `Bool?` -- present on success, absent on a bad handle.|||||||f")
    v.push("qt_window_visible|vyb_qt_window_visible|__vyb_qt_window_visible|w:Int|Bool|int1|0|true while window `w` is visible, else false.|||||||f")
    v.push("qt_screen_width|vyb_qt_screen_width|__vyb_qt_screen_width||Int|int0|-1|Primary screen width in logical pixels. Returns `Int?` -- present holding the width, absent if no screen is available.|||||||f")
