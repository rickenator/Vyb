cmp_triples(a<ImpTriple>, b<ImpTriple>)<Int> -> {
    c<Int> = a.target.compare(b.target)
    if (c != 0) { return c }
    c = a.nm.compare(b.nm)
    if (c != 0) { return c }
    if (a.reex == b.reex) { return 0 }
    if (a.reex) { return 1 }
    return -1
}

