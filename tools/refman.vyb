    keys<Vec<String>> = Vec<String>()
    i<Int> = 0
    while (i < n) {
        el<Edge> = v.get(i)
        keys.push(el.etype + chr(1) + el.from_module + chr(1) + el.from_symbol + chr(1) + el.to_module + chr(1) + el.to_symbol)
        i = i + 1
    }
    ord<Vec<Int>> = Vec<Int>()
    i = 0
    while (i < n) { ord.push(i); i = i + 1 }
    k<Int> = 1
    while (k < n) {
        ck<Int> = ord.get(k)
        key<String> = keys.get(ck)
        j<Int> = k - 1
        while (j >= 0) {
            if (keys.get(ord.get(j)).compare(key) <= 0) { break }
            ord.set(j + 1, ord.get(j))
            j = j - 1
        }
        ord.set(j + 1, ck)
        k = k + 1
    }
    return ord
}

cmp_syms(a<Symbol>, b<Symbol>)<Int> -> {
