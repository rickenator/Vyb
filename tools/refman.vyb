// @not-a-test: true
# refman.vyb -- hyperlinked reference manual generator for the Vyb stdlib.
#
# Vyb port of tools/refman.py (part of the "no Python in the tool path" work,
# #226). Scans stdlib/**/*.vyb and emits a Markdown refman under --emit-dir whose
# core value is the *inter-relationship graph*: modules, files, exported symbols
# and the import / implement / uses-type / runtime / call / prose-reference edges
# between them. Prose is reused from existing '#'/'//' doc comments.
#
# Deterministic: a clean tree regenerates byte-identical output.
#
# Usage (from the repo root):
#   VYB_STDLIB=$PWD/stdlib build/vyb tools/refman.vyb                # write docs/refman
#   VYB_STDLIB=$PWD/stdlib build/vyb tools/refman.vyb --check        # validate + drift
#   VYB_STDLIB=$PWD/stdlib build/vyb tools/refman.vyb --emit-dir X --check
#
# Flags: --emit-dir DIR  --stdlib DIR  --runtime C_FILE  --check
#
# NOTE: the compiler itself consumes a bare `--check` (its canonical-format
# check) before this program runs, so the working spellings are
# `--check=1` / `--check=true` / bare `check`, or VYB_REFMAN_CHECK=1.
#
# Porting notes: this language has no regex (the Python tool's patterns are
# hand-written scanners here), no json module (graph.json is escaped by hand),
# no argv primitive (flags come from /proc/self/cmdline) and no String::to_int in
# this build (hence digits_to_int).
import env::{env_get}
import io::{close, open_read, open_write, read_all, write_str}
import process::{exec_output}

# ------------------------------------------------------------------ data model

# One `name<Type>` parameter/field pair inside a declaration.
struct ArgPair {
    name<String>,
    ty<String>
}

# One parsed declaration member: a struct field, an enum variant, or an
# aspect/bind method (methods carry `args` and `ret`).
struct Member {
    kind<String>,
    name<String>,
    ty<String>,
    ret<String>,
    args<Vec<ArgPair>>
}

# One declaration found by the file parser.
struct Symbol {
    name<String>,
    kind<String>,
    signature<String>,
    tvar<String>,
    asp<String>,
    target<String>,
    ret<String>,
    doc<String>,
    body<String>,
    exported<Bool>,
    rel<String>,
    params<Vec<Member>>,
    fparams<Vec<ArgPair>>
}

# One `import ...` / `share(all) import ...` statement.
struct ImportDecl {
    target<String>,
    names<Vec<String>>,
    reexport<Bool>,
    doc<String>
}

# One parsed source file.
struct FileRec {
    rel<String>,
    symbols<Vec<Symbol>>,
    imports<Vec<ImportDecl>>,
    header<String>
}

# One relationship edge. `has_to_module` is false for runtimeRef edges (the
# Python dict omits the key there), `has_flags` is true only for import edges
# (they carry `reexport` / `resolved`).
struct Edge {
    etype<String>,
    from_module<String>,
    from_symbol<String>,
    to_module<String>,
    to_symbol<String>,
    has_to_module<Bool>,
    has_flags<Bool>,
    reexport<Bool>,
    resolved<Bool>
}

# Exported symbol location, used for the name index (the omnisearch).
struct OmniRef {
    m<String>,
    n<String>
}

# A cross-module struct/enum definition (last definition of a name wins).
struct StructEnt {
    tm<String>,
    name<String>,
    kind<String>,
    doc<String>
}

# A consumer record: key (tm, ts) plus (fm, fsym, etype, reexport).
struct Rec {
    tm<String>,
    ts<String>,
    fm<String>,
    fsym<String>,
    etype<String>,
    reex<Bool>
}

# An `import` triple kept for the module page's Imports section.
struct ImpTriple {
    target<String>,
    nm<String>,
    reex<Bool>
}

# A `name` + rendered link pair (cross-index enumeration).
struct NameLink {
    name<String>,
    link<String>
}

# A module/name key pair.
struct PairKey {
    a<String>,
    b<String>
}

# Fan-in / fan-out module lists.
struct Fans {
    inm<Vec<String>>,
    outm<Vec<String>>
}

# Result of extract_call.
struct ParseCall {
    ok<Bool>,
    name<String>,
    params<Vec<ArgPair>>,
    ret<String>
}

# Result of a bracket scan.
struct Span {
    a<Int>,
    b<Int>
}

# Result of matching a generic `name<Type>` part.
struct MemberParse {
    ok<Bool>,
    name<String>,
    ty<String>
}

# Result of parse_import's target/name split.
struct ImportParse {
    ok<Bool>,
    target<String>,
    names<Vec<String>>
}

# The relationship graph.
struct Graph {
    module_order<Vec<String>>,
    files<Vec<FileRec>>,
    edges<Vec<Edge>>,
    omni<Vec<OmniRef>>,
    rt_keys<Vec<String>>,
    rt_lines<Vec<Int>>,
    git_rev<String>
}

# ------------------------------------------------------- small string helpers

# Byte at index `i` of `s` (0 when out of range).
byte_at(s<String>, i<Int>)<Int> -> {
    if (i < 0 || i >= s.len()) { return 0 }
    return (s.char_at(i) as Int) & 0xFF
}

chr(c<Int>)<String> -> { return String::from_byte(c) }
lit_quote()<String> -> { return "\"" }
lit_bs()<String> -> { return "\\" }
lit_nl()<String> -> { return "\n" }

is_ws(c<Int>)<Bool> -> {
    return (c == 32 || c == 9 || c == 10 || c == 13 || c == 12 || c == 11)
}

is_digit(c<Int>)<Bool> -> { return (c >= 48 && c <= 57) }

is_word(c<Int>)<Bool> -> {
    return ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95)
}

is_alpha_start(c<Int>)<Bool> -> {
    return ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95)
}

is_hex(c<Int>)<Bool> -> {
    return ((c >= 48 && c <= 57) || (c >= 97 && c <= 102))
}

is_seg_char(c<Int>)<Bool> -> {
    return !(is_ws(c) || c == 123 || c == 125 || c == 58)
}

# Strip leading/trailing whitespace (spaces, tabs, CR, LF, VT, FF) from `s`.
trim(s<String>)<String> -> {
    a<Int> = 0
    n<Int> = s.len()
    while (a < n) {
        c<Int> = byte_at(s, a)
        if (is_ws(c)) { a = a + 1 } else { break }
    }
    b<Int> = n
    while (b > a) {
        c<Int> = byte_at(s, b - 1)
        if (is_ws(c)) { b = b - 1 } else { break }
    }
    if (b <= a) { return "" }
    return s.substring(a, b)
}

# Drop trailing whitespace only (Python str.rstrip()).
rstrip_ws(s<String>)<String> -> {
    b<Int> = s.len()
    while (b > 0) {
        c<Int> = byte_at(s, b - 1)
        if (is_ws(c)) { b = b - 1 } else { break }
    }
    if (b <= 0) { return "" }
    return s.substring(0, b)
}

# Drop trailing occurrences of `ch`.
rstrip_char(s<String>, ch<Int>)<String> -> {
    b<Int> = s.len()
    while (b > 0) {
        if (byte_at(s, b - 1) == ch) { b = b - 1 } else { break }
    }
    if (b <= 0) { return "" }
    return s.substring(0, b)
}

spaces(n<Int>)<String> -> {
    out<String> = ""
    i<Int> = 0
    while (i < n) {
        out = out + " "
        i = i + 1
    }
    return out
}

bool_str(b<Bool>)<String> -> {
    if (b) { return "true" }
    return "false"
}

# Decimal value of a digit string (stops at the first non-digit).
digits_to_int(s<String>)<Int> -> {
    t<String> = trim(s)
    n<Int> = 0
    i<Int> = 0
    while (i < t.len()) {
        c<Int> = byte_at(t, i)
        if (c < 48 || c > 57) { break }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    return n
}

starts_with(s<String>, p<String>)<Bool> -> {
    if (p.len() > s.len()) { return false }
    i<Int> = 0
    while (i < p.len()) {
        if (byte_at(s, i) != byte_at(p, i)) { return false }
        i = i + 1
    }
    return true
}

ends_with(s<String>, p<String>)<Bool> -> {
    if (p.len() > s.len()) { return false }
    off<Int> = s.len() - p.len()
    i<Int> = 0
    while (i < p.len()) {
        if (byte_at(s, off + i) != byte_at(p, i)) { return false }
        i = i + 1
    }
    return true
}

has_sub(s<String>, p<String>)<Bool> -> {
    return s.index_of_from(p, 0) >= 0
}

count_of(s<String>, ch<Int>)<Int> -> {
    n<Int> = 0
    i<Int> = 0
    while (i < s.len()) {
        if (byte_at(s, i) == ch) { n = n + 1 }
        i = i + 1
    }
    return n
}

join_strs(v<Vec<String>>, sep<String>)<String> -> {
    out<String> = ""
    i<Int> = 0
    while (i < v.len()) {
        if (i > 0) { out = out + sep }
        out = out + v.get(i)
        i = i + 1
    }
    return out
}

# Python str.splitlines() for the boundary bytes this tree uses.
splitlines(s<String>)<Vec<String>> -> {
    out<Vec<String>> = Vec<String>()
    start<Int> = 0
    i<Int> = 0
    n<Int> = s.len()
    while (i < n) {
        c<Int> = byte_at(s, i)
        if (c == 10 || c == 13 || c == 11 || c == 12 || c == 28 || c == 29 || c == 30) {
            out.push(s.substring(start, i))
            if (c == 13 && i + 1 < n && byte_at(s, i + 1) == 10) { i = i + 1 }
            i = i + 1
            start = i
        } else {
            i = i + 1
        }
    }
    if (start < n) { out.push(s.substring(start, n)) }
    return out
}

# Whitespace-separated tokens (Python str.split()).
split_ws(s<String>)<Vec<String>> -> {
    out<Vec<String>> = Vec<String>()
    i<Int> = 0
    n<Int> = s.len()
    while (i < n) {
        while (i < n && is_ws(byte_at(s, i))) { i = i + 1 }
        if (i >= n) { break }
        j<Int> = i
        while (j < n && !is_ws(byte_at(s, j))) { j = j + 1 }
        out.push(s.substring(i, j))
        i = j
    }
    return out
}

# Replace every literal occurrence of `from` with `to`.
replace_all(s<String>, pat<String>, to<String>)<String> -> {
    pl<Int> = pat.len()
    if (pl == 0) { return s }
    out<String> = ""
    i<Int> = 0
    while (i < s.len()) {
        if (i + pl <= s.len() && s.substring(i, i + pl) == pat) {
            out = out + to
            i = i + pl
        } else {
            out = out + chr(byte_at(s, i))
            i = i + 1
        }
    }
    return out
}

# The part of `l` before its first '{'.
head_before_brace(l<String>)<String> -> {
    k<Int> = l.index_of("{")
    if (k < 0) { return l }
    return l.substring(0, k)
}

# Index of the LAST "->" in `h`, or -1.
rfind_arrow(h<String>)<Int> -> {
    k<Int> = h.len() - 2
    while (k >= 0) {
        if (byte_at(h, k) == 45 && byte_at(h, k + 1) == 62) { return k }
        k = k - 1
    }
    return -1
}

# Maximal identifier at the start of `s` ("" when there is none).
leading_ident(s<String>)<String> -> {
    if (s.len() == 0 || !is_alpha_start(byte_at(s, 0))) { return "" }
    i<Int> = 1
    while (i < s.len() && is_word(byte_at(s, i))) { i = i + 1 }
    return s.substring(0, i)
}

# True when `t` is a run of three or more dashes (a horizontal rule).
all_dashes(t<String>)<Bool> -> {
    if (t.len() < 3) { return false }
    i<Int> = 0
    while (i < t.len()) {
        if (byte_at(t, i) != 45) { return false }
        i = i + 1
    }
    return true
}

hex_digit(d<Int>)<String> -> {
    if (d < 10) { return chr(48 + d) }
    return chr(97 + (d - 10))
}

# Four lowercase hex digits of a codepoint (JSON \\uXXXX escape).
hex4(c<Int>)<String> -> {
    v<Int> = c
    d3<Int> = v % 16
    v = v / 16
    d2<Int> = v % 16
    v = v / 16
    d1<Int> = v % 16
    v = v / 16
    d0<Int> = v % 16
    return hex_digit(d0) + hex_digit(d1) + hex_digit(d2) + hex_digit(d3)
}

# ------------------------------------------------------- filesystem / shell

# Read a whole file as a String ("" when it cannot be read).
slurp(path<String>)<String> -> {
    text<String> = ""
    match (open_read(path)) {
        f -> {
            match (read_all(f)) { s -> { text = s } ? -> { } }
            close(f)
        }
        ? -> { }
    }
    return text
}

# Run `cmd` through the shell and return its stdout ("" when it could not run).
run_sh(cmd<String>)<String> -> {
    out<String> = ""
    freedom {
        match (exec_output(cmd)) {
            s -> { out = s }
            ? -> { out = "" }
        }
    }
    return out
}

# True when `p` exists (file or directory).
path_exists(p<String>)<Bool> -> {
    return (trim(run_sh("test -e '" + p + "' && echo yes || echo no")) == "yes")
}

# True when `p` is an existing directory.
dir_exists(p<String>)<Bool> -> {
    return (trim(run_sh("test -d '" + p + "' && echo yes || echo no")) == "yes")
}

# Write `text` to `path` (parents must exist). True on success.
write_text(path<String>, text<String>)<Bool> -> {
    ok<Bool> = false
    match (open_write(path)) {
        f -> {
            match (write_str(f, text)) { n -> { ok = true } ? -> { } }
            close(f)
        }
        ? -> { }
    }
    return ok
}

join_path(a<String>, b<String>)<String> -> {
    if (a.len() == 0) { return b }
    if (b.len() == 0) { return a }
    if (ends_with(a, "/")) { return a + b }
    return a + "/" + b
}

# Index of the last '/' in `p`, or -1.
last_slash(p<String>)<Int> -> {
    i<Int> = p.len() - 1
    while (i >= 0) {
        if (byte_at(p, i) == 47) { return i }
        i = i - 1
    }
    return -1
}

# Directory part of `p` ("" when there is no slash).
dirname_of(p<String>)<String> -> {
    i<Int> = last_slash(p)
    if (i < 0) { return "" }
    return p.substring(0, i)
}

# Entry names directly inside `dir` (non-hidden, Python glob('*') semantics).
list_dir_names(dir<String>)<Vec<String>> -> {
    out<Vec<String>> = Vec<String>()
    lines<Vec<String>> = splitlines(run_sh("ls -1 '" + dir + "' 2>/dev/null"))
    i<Int> = 0
    while (i < lines.len()) {
        p<String> = trim(lines.get(i))
        if (p.len() > 0) { out.push(p) }
        i = i + 1
    }
    return out
}

# Every `*.vyb` under `dir`, as absolute-ish paths sorted byte-wise.
list_vyb(dir<String>)<Vec<String>> -> {
    out<Vec<String>> = Vec<String>()
    lines<Vec<String>> = splitlines(run_sh("find '" + dir + "' -name '*.vyb' 2>/dev/null | LC_ALL=C sort"))
    i<Int> = 0
    while (i < lines.len()) {
        p<String> = trim(lines.get(i))
        if (p.len() > 0) { out.push(p) }
        i = i + 1
    }
    return out
}

# ------------------------------------------------------------- lexer helpers

# Drop a trailing '// ...' (not inside a string literal) from a line.
strip_inline_comment(line<String>)<String> -> {
    out<String> = ""
    in_str<Bool> = false
    i<Int> = 0
    n<Int> = line.len()
    while (i < n) {
        c<Int> = byte_at(line, i)
        if (c == 34) { in_str = !in_str }
        else if (c == 47 && i + 1 < n && byte_at(line, i + 1) == 47 && !in_str) { break }
        out = out + chr(c)
        i = i + 1
    }
    return out
}

# Split on a top-level single-character separator, dropping empty parts.
split_top(s<String>, sep<Int>)<Vec<String>> -> {
    parts<Vec<String>> = Vec<String>()
    cur<String> = ""
    stack<Vec<Int>> = Vec<Int>()
    i<Int> = 0
    while (i < s.len()) {
        ch<Int> = byte_at(s, i)
        if (ch == 60 || ch == 40 || ch == 91) {
            stack.push(ch)
        } else if (ch == 62 || ch == 41 || ch == 93) {
            if (stack.len() > 0 && matches_bracket(stack.get(stack.len() - 1), ch)) { stack.pop() }
        }
        if (ch == sep && stack.len() == 0) {
            t<String> = trim(cur)
            if (t.len() > 0) { parts.push(t) }
            cur = ""
        } else {
            cur = cur + chr(ch)
        }
        i = i + 1
    }
    t<String> = trim(cur)
    if (t.len() > 0) { parts.push(t) }
    return parts
}

# True when closing bracket `c` matches opening bracket `o`.
matches_bracket(o<Int>, c<Int>)<Bool> -> {
    if (o == 60) { return c == 62 }
    if (o == 40) { return c == 41 }
    return c == 93
}

# Index of the ')' matching the '(' at `start`, or -1.
match_paren(s<String>, start<Int>, o<Int>, c<Int>)<Int> -> {
    d<Int> = 0
    i<Int> = start
    while (i < s.len()) {
        ch<Int> = byte_at(s, i)
        if (ch == o) {
            d = d + 1
        } else if (ch == c) {
            d = d - 1
            if (d == 0) { return i }
        }
        i = i + 1
    }
    return -1
}

# Given s[start]=='<', the (open, close) span honouring nesting.
bracket_span(s<String>, start<Int>)<Span> -> {
    d<Int> = 0
    i<Int> = start
    while (i < s.len()) {
        ch<Int> = byte_at(s, i)
        if (ch == 60) {
            d = d + 1
        } else if (ch == 62) {
            d = d - 1
            if (d == 0) { return Span { a = start, b = i } }
        }
        i = i + 1
    }
    return Span { a = start, b = s.len() - 1 }
}

# First '->' that is not inside <...>(...)[...], or -1.
find_arrow(s<String>)<Int> -> {
    stack<Vec<Int>> = Vec<Int>()
    i<Int> = 0
    while (i < s.len() - 1) {
        ch<Int> = byte_at(s, i)
        if (ch == 60 || ch == 40 || ch == 91) {
            stack.push(ch)
        } else if (ch == 62 || ch == 41 || ch == 93) {
            if (stack.len() > 0 && matches_bracket(stack.get(stack.len() - 1), ch)) { stack.pop() }
        } else if (ch == 45 && byte_at(s, i + 1) == 62 && stack.len() == 0) {
            return i
        }
        i = i + 1
    }
    return -1
}

# Match `^([A-Za-z_]\w*)\s*<(.+)>$` against one generic part.
match_gen_field(part<String>)<MemberParse> -> {
    if (part.len() == 0 || !is_alpha_start(byte_at(part, 0))) {
        return MemberParse { ok = false, name = "", ty = "" }
    }
    i<Int> = 1
    while (i < part.len() && is_word(byte_at(part, i))) { i = i + 1 }
    nm<String> = part.substring(0, i)
    while (i < part.len() && is_ws(byte_at(part, i))) { i = i + 1 }
    if (i >= part.len() || byte_at(part, i) != 60) {
        return MemberParse { ok = false, name = "", ty = "" }
    }
    if (byte_at(part, part.len() - 1) != 62) {
        return MemberParse { ok = false, name = "", ty = "" }
    }
    if (part.len() - 1 <= i + 1) {
        return MemberParse { ok = false, name = "", ty = "" }
    }
    inner<String> = part.substring(i + 1, part.len() - 1)
    if (has_sub(inner, "\n")) {
        return MemberParse { ok = false, name = "", ty = "" }
    }
    return MemberParse { ok = true, name = nm, ty = inner }
}

# Parse `name(a<T>, b<U>)<Ret>` -> (name, params, ret).
extract_call(sig<String>)<ParseCall> -> {
    op<Int> = sig.index_of("(")
    if (op == -1) { return ParseCall { ok = false, name = "", params = Vec<ArgPair>(), ret = "" } }
    cp<Int> = match_paren(sig, op, 40, 41)
    if (cp == -1) { return ParseCall { ok = false, name = "", params = Vec<ArgPair>(), ret = "" } }
    toks<Vec<String>> = split_ws(sig.substring(0, op))
    nm<String> = ""
    if (toks.len() > 0) { nm = toks.get(toks.len() - 1) }
    if (nm.len() == 0 || starts_with(nm, "(")) {
        return ParseCall { ok = false, name = "", params = Vec<ArgPair>(), ret = "" }
    }
    params<Vec<ArgPair>> = Vec<ArgPair>()
    parts<Vec<String>> = split_top(sig.substring(op + 1, cp), 44)
    i<Int> = 0
    while (i < parts.len()) {
        pv<String> = parts.get(i)
        mf<MemberParse> = match_gen_field(pv)
        if (mf.ok) {
            params.push(ArgPair { name = mf.name, ty = mf.ty })
        } else {
            params.push(ArgPair { name = pv, ty = "" })
        }
        i = i + 1
    }
    ret<String> = ""
    tail<String> = trim(sig.substring(cp + 1, sig.len()))
    if (starts_with(tail, "<")) {
        sp<Span> = bracket_span(tail, 0)
        ret = tail.substring(sp.a + 1, sp.b)
    }
    return ParseCall { ok = true, name = nm, params = params, ret = ret }
}

# Peel a leading `#`/`//` comment marker, keeping relative indentation.
strip_comment(ln<String>)<String> -> {
    s<String> = trim(ln)
    i<Int> = 0
    while (i < s.len() && (byte_at(s, i) == 35 || byte_at(s, i) == 47)) { i = i + 1 }
    if (i < s.len() && byte_at(s, i) == 32) { i = i + 1 }
    return s.substring(i, s.len())
}

# First meaningful doc line (skips leading horizontal-rule separators).
doc_summary(doc<String>)<String> -> {
    lines<Vec<String>> = splitlines(doc)
    i<Int> = 0
    while (i < lines.len()) {
        t<String> = trim(lines.get(i))
        if (t.len() > 0 && !all_dashes(t)) { return t }
        i = i + 1
    }
    return ""
}

# ------------------------------------------------------------- stable sorts

# Stable insertion sort of Vec<String> (ascending byte order).
sort_strs(v<their<Vec<String>>>) -> {
    n<Int> = v.len()
    if (n <= 1) { return }
    ord<Vec<Int>> = ord_sort_strs(v)
    src<Vec<String>> = Vec<String>()
    i<Int> = 0
    while (i < n) { src.push(v.get(i)); i = i + 1 }
    v.clear()
    i = 0
    while (i < n) { v.push(src.get(ord.get(i))); i = i + 1 }
}

ord_sort_strs(v<Vec<String>>)<Vec<Int>> -> {
    n<Int> = v.len()
    keys<Vec<String>> = Vec<String>()
    i<Int> = 0
    while (i < n) {
        el<String> = v.get(i)
        keys.push(el + "")
        i = i + 1
    }
    ord<Vec<Int>> = Vec<Int>()
    i = 0
    while (i < n) { ord.push(i); i = i + 1 }
    k<Int> = 1
    while (k < n) {
        ck<Int> = ord.get(k)
        key<String> = keys.get(ck)
        j<Int> = k - 1
        while (j >= 0) {
            if (keys.get(ord.get(j)).compare(key) <= 0) { break }
            ord.set(j + 1, ord.get(j))
            j = j - 1
        }
        ord.set(j + 1, ck)
        k = k + 1
    }
    return ord
}

# Drop adjacent duplicates from a sorted Vec<String>.
dedupe_strs(v<their<Vec<String>>>) -> {
    out<Vec<String>> = Vec<String>()
    i<Int> = 0
    while (i < v.len()) {
        if (i == 0 || v.get(i) != v.get(i - 1)) { out.push(v.get(i)) }
        i = i + 1
    }
    v.clear()
    i = 0
    while (i < out.len()) {
        v.push(out.get(i))
        i = i + 1
    }
}

