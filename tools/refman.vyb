cmp_edges(a<Edge>, b<Edge>)<Int> -> {
    c<Int> = a.etype.compare(b.etype)
    if (c != 0) { return c }
    c = a.from_module.compare(b.from_module)
    if (c != 0) { return c }
    c = a.from_symbol.compare(b.from_symbol)
    if (c != 0) { return c }
    c = a.to_module.compare(b.to_module)
    if (c != 0) { return c }
    return a.to_symbol.compare(b.to_symbol)
}

# Stable insertion sort of the relationship edges by the Python sort key.
sort_edges(v<their<Vec<Edge>>>) -> {
    n<Int> = v.len()
    if (n <= 1) { return }
    ord<Vec<Int>> = ord_sort_edges(v)
    src<Vec<Edge>> = Vec<Edge>()
    i<Int> = 0
    while (i < n) { src.push(v.get(i)); i = i + 1 }
    v.clear()
    i = 0
    while (i < n) { v.push(src.get(ord.get(i))); i = i + 1 }
}

ord_sort_edges(v<Vec<Edge>>)<Vec<Int>> -> {
